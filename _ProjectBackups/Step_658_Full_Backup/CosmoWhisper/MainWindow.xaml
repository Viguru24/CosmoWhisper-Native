<Window x:Class="CosmoWhisper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CosmoWhisper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="CosmoWhisper Ghost Machine" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <Button x:Name="RecordButton" Content="Start Recording" Height="50" Width="200" Click="RecordButton_Click"/>
            
            <TextBlock Text="Audio Level" Margin="0,20,0,5"/>
            <ProgressBar x:Name="AudioLevelMeter" Minimum="-160" Maximum="0" Height="20" Value="-160"/>
            
            <TextBlock Text="Transcription Output" Margin="0,20,0,5"/>
            <TextBox x:Name="OutputTextBox" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>

            <TextBlock Text="Manus Agent Feedback" Margin="0,20,0,5" FontWeight="Bold" Foreground="Blue"/>
            <TextBox x:Name="ManusTextBox" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="#F0F8FF"/>
        </StackPanel>
    </Grid>
</Window>
