<Window x:Class="CosmoWhisper.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Managers="clr-namespace:CosmoWhisper.Managers"
        Title="CosmoWhisper Dashboard" Height="600" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Margin="5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#40FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.98" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.98" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Background="#40FFFFFF" Opacity="0.5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMPREHENSIVE DARK COMBOBOX STYLE -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252A3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path x:Name="Arrow" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#353A4D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1A1C30" BorderThickness="1" BorderBrush="#40FFFFFF" CornerRadius="8"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#1A1C30"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#1A1C30"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Glow -->
        <Ellipse x:Name="Glow1" Fill="#50007AFF" Width="600" Height="600" Margin="-200,-200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.7" Duration="0:0:5"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="-200,-200,0,0" To="-150,-150,0,0" Duration="0:0:8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
        <Ellipse x:Name="Glow2" Fill="#508000FF" Width="500" Height="500" Margin="0,0,-100,-100" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.7" Duration="0:0:6"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,-100,-100" To="0,0,-50,-50" Duration="0:0:10"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <Ellipse x:Name="Glow3" Fill="#3000FFD4" Width="400" Height="400" Margin="100,-150,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="0.5" Duration="0:0:7"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="100,-150,0,0" To="150,-100,0,0" Duration="0:0:12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <Ellipse x:Name="Glow4" Fill="#20FF007A" Width="300" Height="300" Margin="-100,0,0,-150" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Ellipse.Effect><BlurEffect Radius="150"/></Ellipse.Effect>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.1" To="0.4" Duration="0:0:9"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="-100,0,0,-150" To="-50,0,0,-100" Duration="0:0:15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Glass Container -->
        <Border CornerRadius="30" Margin="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF131B2E" Offset="0"/>
                    <GradientStop Color="#FF0B1020" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#60FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.4"/>
                    <GradientStop Color="#05FFFFFF" Offset="0.6"/>
                    <GradientStop Color="#25FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.3" ShadowDepth="0"/>
            </Border.Effect>
            <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="30">
                <Grid x:Name="MainContainer">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Path=Preferences.UIScale, Source={x:Static Managers:PreferenceManager.Shared}}" 
                                       ScaleY="{Binding Path=Preferences.UIScale, Source={x:Static Managers:PreferenceManager.Shared}}"/>
                    </Grid.LayoutTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="#1A1C30" CornerRadius="30,0,0,30">
                        <StackPanel Margin="10,40,10,10">
                            <TextBlock Text="CosmoWhisper" Margin="20,0,0,30" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            
                            <!-- Main Navigation -->
                            <Button x:Name="BtnDashboard" Content="&#x1F4CA; Dashboard" Style="{StaticResource SidebarButton}" Click="Dashboard_Click"/>
                            <Button x:Name="BtnSmartCommands" Content="&#x26A1; Smart Commands" Style="{StaticResource SidebarButton}" Click="SmartCommands_Click"/>
                            
                            
                            <!-- Settings Group -->
                            <TextBlock Text="SETTINGS" Margin="20,20,0,10" Foreground="White" Opacity="0.4" FontSize="10" FontWeight="SemiBold"/>
                            <Button x:Name="BtnMicrophone" Content="&#x1F3A4; Microphone" Style="{StaticResource SidebarButton}" Click="Microphone_Click"/>
                            <Button x:Name="BtnVocabulary" Content="&#x1F5E3; Vocabulary" Style="{StaticResource SidebarButton}" Click="Vocabulary_Click"/>
                            <Button x:Name="BtnNarration" Content="&#x1F50A; Narration" Style="{StaticResource SidebarButton}" Click="Narration_Click"/>
                            <Button x:Name="BtnIntelligence" Content="&#x1F9E0; Intelligence" Style="{StaticResource SidebarButton}" Click="Intelligence_Click"/>
                            <Button x:Name="BtnPreferences" Content="&#x2699; Preferences" Style="{StaticResource SidebarButton}" Click="Preferences_Click"/>
                            <Button x:Name="BtnLibrary" Content="&#x1F4DA; Library" Style="{StaticResource SidebarButton}" Click="Library_Click"/>
                            <Button x:Name="BtnLanguage" Content="&#x1F310; Language" Style="{StaticResource SidebarButton}" Click="Language_Click"/>
                            <Button x:Name="BtnAccount" Content="&#x1F464; Account" Style="{StaticResource SidebarButton}" Click="Account_Click"/>

                            <!-- Exit Button -->
                            <Button Content="&#x1F6AA; Exit App" Style="{StaticResource SidebarButton}" Margin="5,60,5,5" Foreground="#FFFF453A" Click="Exit_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Main Content -->
                    <Grid Grid.Column="1" Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <!-- Dashboard Header -->
                            <StackPanel x:Name="DashboardHeader">
                                <TextBlock Text="Productivity" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Your dictation efficiency at a glance." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>
                            
                            <!-- Smart Commands Header (Hidden by default) -->
                            <StackPanel x:Name="SmartCommandsHeader" Visibility="Collapsed">
                                <TextBlock Text="Smart Commands" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Voice-activated shortcuts for your active text field." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Microphone Header (Hidden by default) -->
                            <StackPanel x:Name="MicrophoneHeader" Visibility="Collapsed">
                                <TextBlock Text="Audio Input" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Manage your recording hardware." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Vocabulary Header -->
                            <StackPanel x:Name="VocabularyHeader" Visibility="Collapsed">
                                <TextBlock Text="Personal Dictionary" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Teach CosmoWhisper your names and specific terminology." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Narration Header (Hidden by default) -->
                            <StackPanel x:Name="NarrationHeader" Visibility="Collapsed">
                                <TextBlock Text="Voice &amp; Narration" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Fine-tune how AI reads text back to you." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>
                            <!-- Intelligence Header -->
                            <StackPanel x:Name="IntelligenceHeader" Visibility="Collapsed">
                                <TextBlock Text="Intelligence" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Configure your AI Provider and Personality." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Preferences Header -->
                            <StackPanel x:Name="PreferencesHeader" Visibility="Collapsed">
                                <TextBlock Text="Preferences" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="System configuration and backups." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Language Header -->
                            <StackPanel x:Name="LanguageHeader" Visibility="Collapsed">
                                <TextBlock Text="Language" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Choose your preferred interface language." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Account Header -->
                            <StackPanel x:Name="AccountHeader" Visibility="Collapsed">
                                <TextBlock Text="Account" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Manage your subscription and profile." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Login Header -->
                            <StackPanel x:Name="LoginHeader" Visibility="Collapsed">
                                <TextBlock Text="Welcome Back" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Sign in to access your pro features." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Content Area -->
                        <Grid Grid.Row="1">
                            <!-- VIEW 1: PRODUCTIVITY DASHBOARD -->
                            <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <!-- Pro Banner -->
                                    <Border Background="#252A3D" CornerRadius="12" BorderBrush="#30007AFF" BorderThickness="1" Margin="0,0,0,30">
                                        <Grid Margin="25">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                                <Border Background="#30007AFF" Width="32" Height="32" CornerRadius="8" Margin="0,0,15,0">
                                                    <TextBlock Text="&#x26A1;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#007AFF"/>
                                                </Border>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="TxtTierStatus" Text="Pro Unlocked" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock x:Name="TierIcon" Text="&#x1F513;" Margin="5,0,0,0" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtUsageLabel" Text="Usage Limit Removed" Foreground="White" Opacity="0.6" FontSize="12"/>
                                                </StackPanel>
                                                
                                                <TextBlock x:Name="TxtUsageStats" Text="1.7 / &#x221E;" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="250,0,0,0"/>
                                            </StackPanel>

                                            <!-- Progress Bar -->
                                            <Grid Grid.Row="1">
                                                <Border Height="6" Background="#20FFFFFF" CornerRadius="3"/>
                                                <Border x:Name="UsageProgressBar" HorizontalAlignment="Left" Width="300" Height="6" Background="#007AFF" CornerRadius="3">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#007AFF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Stats Cards Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Total Words -->
                                        <Border Grid.Column="0" Background="#1A1C30" CornerRadius="12" Height="100" Margin="0,0,10,0" BorderBrush="#15FFFFFF" BorderThickness="1">
                                            <StackPanel VerticalAlignment="Center" Margin="25,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBlock Text="&#x1F4AC;" FontSize="12" Opacity="0.7" Margin="0,0,10,0"/>
                                                    <TextBlock Text="TOTAL WORDS" Foreground="White" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="23,797" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Time Saved -->
                                        <Border Grid.Column="1" Background="#1A1C30" CornerRadius="12" Height="100" Margin="5,0,5,0" BorderBrush="#15FFFFFF" BorderThickness="1">
                                            <StackPanel VerticalAlignment="Center" Margin="25,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBlock Text="&#x1F4C8;" FontSize="12" Opacity="0.7" Margin="0,0,10,0"/>
                                                    <TextBlock Text="TIME SAVED" Foreground="White" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="6h" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Transcriptions -->
                                        <Border Grid.Column="2" Background="#1A1C30" CornerRadius="12" Height="100" Margin="10,0,0,0" BorderBrush="#15FFFFFF" BorderThickness="1">
                                            <StackPanel VerticalAlignment="Center" Margin="25,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBlock Text="&#x1F504;" FontSize="12" Opacity="0.7" Margin="0,0,10,0"/>
                                                    <TextBlock Text="TRANSCRIPTIONS" Foreground="White" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock Text="1,987" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 2: SMART COMMANDS (Hidden by default) -->
                            <ScrollViewer x:Name="SmartCommandsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="&#x1F4DD; Magic Spells" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                    <Button HorizontalAlignment="Right" Content="&#x1F310; Open Cloud Library" Background="#15FFFFFF" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="SemiBold" Click="OpenLibraryWeb_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <!-- Text Manipulation Section -->
                                <TextBlock Text="&#x1F4DD; Text Manipulation" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <WrapPanel Margin="0,0,0,30">
                                    <Border Width="220" Height="120" Background="#252A3D" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <StackPanel Margin="15" VerticalAlignment="Center">
                                            <TextBlock Text="Select All" Foreground="White" FontSize="16" FontWeight="Medium"/>
                                            <TextBlock Text="Selects all text" Foreground="White" Opacity="0.6" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="220" Height="120" Background="#252A3D" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <StackPanel Margin="15" VerticalAlignment="Center">
                                            <TextBlock Text="Delete All" Foreground="White" FontSize="16" FontWeight="Medium"/>
                                            <TextBlock Text="or 'Clear All'" Foreground="#007AFF" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="Deletes everything" Foreground="White" Opacity="0.6" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="220" Height="120" Background="#15FFFFFF" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <StackPanel Margin="15" VerticalAlignment="Center">
                                            <TextBlock Text="Copy All" Foreground="White" FontSize="16" FontWeight="Medium"/>
                                            <TextBlock Text="or 'Copy That'" Foreground="#007AFF" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="Copies to clipboard" Foreground="White" Opacity="0.6" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="220" Height="120" Background="#15FFFFFF" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <StackPanel Margin="15" VerticalAlignment="Center">
