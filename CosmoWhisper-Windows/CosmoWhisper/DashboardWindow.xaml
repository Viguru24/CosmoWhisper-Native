<Window x:Class="CosmoWhisper.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Managers="clr-namespace:CosmoWhisper.Managers"
        xmlns:controls="clr-namespace:CosmoWhisper.Controls"
        xmlns:views="clr-namespace:CosmoWhisper.Views"
        Title="CosmoWhisper Dashboard" Height="850" Width="1100"
        MinWidth="960" MinHeight="640"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" Background="#0D0D10"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="RootContentBorder" Background="{DynamicResource ThemeWindowBackdropBrush}">
            <Grid x:Name="MainContainer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Navigation Rail -->
                    <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Minimalist Brand Header -->
                            <StackPanel Grid.Row="0" Margin="0,28,0,22" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="14" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Image Source="sidebar_logo.png" Width="52" Height="52" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Cosmo" FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                                    <TextBlock Text="Whisper" FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="Normal" Foreground="{DynamicResource ThemeSecondaryBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="VOICE INTELLIGENCE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Navigation Buttons -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,0,14,10">
                                    <Button x:Name="BtnDashboard" Style="{DynamicResource SidebarButton}" Click="Dashboard_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                            </Grid>
                                            <TextBlock Text="Dashboard" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" FontWeight="Medium" FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnAccount" Style="{DynamicResource SidebarButton}" Click="Account_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                            </Grid>
                                            <TextBlock Text="Account" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" FontWeight="Medium" FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnSmartCommands" Style="{DynamicResource SidebarButton}" Click="SmartCommands_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="M13,2 L4.5,13.5 L11,13.5 L9.5,22 L19.5,10.5 L13,10.5 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                            </Grid>
                                            <TextBlock Text="Smart Commands" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" FontWeight="Medium" FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnLibrary" Style="{DynamicResource SidebarButton}" Click="Library_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="M4,4 L18,4 C19.1,4 20,4.9 20,6 L20,18 C20,19.1 19.1,20 18,20 L4,20 C4,18 4,6 4,4 Z M6,6 L6,18 L18,18 L18,6 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                                            </Grid>
                                            <TextBlock Text="Library" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" FontWeight="Medium" FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnPreferences" Style="{DynamicResource SidebarButton}" Click="Preferences_Click" MouseRightButtonDown="Preferences_MouseRightButtonDown">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="SidebarGearIcon" Style="{DynamicResource FluentIconStyle}" Text="&#xE713;" FontSize="16" Foreground="{DynamicResource ThemeSecondaryBrush}"/>
                                            </Grid>
                                            <TextBlock Text="Preferences" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" FontWeight="Medium" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Sidebar Footer -->
                            <StackPanel Grid.Row="2" Margin="10,0,14,20">
                                <Separator Margin="12,0,12,12"/>
                                <TextBlock x:Name="TxtUserEmail" Visibility="Collapsed"/>

                                <Button Style="{DynamicResource SidebarButton}" Click="Exit_Click" ToolTip="Completely close CosmoWhisper">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="18" Height="18" Margin="0,0,12,0">
                                            <Path Data="M13,3 L16,3 C17.1,3 18,3.9 18,5 L18,19 C18,20.1 17.1,21 16,21 L13,21 M10,17 L15,12 L10,7 M15,12 L3,12"
                                                  Stroke="{DynamicResource ThemeDangerBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Quit App" Foreground="{DynamicResource ThemeDangerBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="TxtAppVersion" Text="v2.3.67" Foreground="{DynamicResource ThemeMutedBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content Pane -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeBackgroundBrush}">

                        <Grid>
                            <!-- Native Win11 Caption Cluster (Top Right) -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,12,14,0"
                                        Panel.ZIndex="1000">
                                <Button x:Name="BtnMinimizeWindow"
                                        Content="&#xE921;"
                                        Style="{StaticResource WindowCaptionButtonStyle}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="Minimize_Click"
                                        ToolTip="Minimize"
                                        AutomationProperties.Name="Minimize"/>
                                <Button x:Name="BtnMaximizeRestore"
                                        Content="&#xE922;"
                                        Style="{StaticResource WindowCaptionButtonStyle}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="MaximizeRestore_Click"
                                        ToolTip="Maximize"
                                        Margin="2,0"
                                        AutomationProperties.Name="Maximize or Restore"/>
                                <Button x:Name="BtnCloseToTray"
                                        Content="&#xE8BB;"
                                        Style="{StaticResource WindowCaptionButtonStyle}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="Close_Click"
                                        ToolTip="Hide to System Tray"
                                        AutomationProperties.Name="Hide to System Tray"/>
                            </StackPanel>

                            <!-- Content Grid -->
                            <Grid Margin="32,26,32,26">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Margin="0,0,120,24">
                                    <!-- Dashboard Header -->
                                    <StackPanel x:Name="DashboardHeader">
                                        <TextBlock Text="Productivity" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Your dictation efficiency at a glance." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Smart Commands Header -->
                                    <StackPanel x:Name="SmartCommandsHeader" Visibility="Collapsed">
                                        <TextBlock Text="Smart Commands" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Voice-activated shortcuts for your active text field." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Microphone Header -->
                                    <StackPanel x:Name="MicrophoneHeader" Visibility="Collapsed">
                                        <TextBlock Text="Audio Input" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Manage your recording hardware." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Vocabulary Header -->
                                    <StackPanel x:Name="VocabularyHeader" Visibility="Collapsed">
                                        <TextBlock Text="Personal Dictionary" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Teach CosmoWhisper your names and specific terminology." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Narration Header -->
                                    <StackPanel x:Name="NarrationHeader" Visibility="Collapsed">
                                        <TextBlock Text="Voice &amp; Narration" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Fine-tune how AI reads text back to you." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Intelligence Header -->
                                    <StackPanel x:Name="IntelligenceHeader" Visibility="Collapsed">
                                        <TextBlock Text="Intelligence" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Configure your AI Provider and Personality." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Preferences Header -->
                                    <StackPanel x:Name="PreferencesHeader" Visibility="Collapsed">
                                        <TextBlock Text="Preferences" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="System configuration and backups." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Button x:Name="TabPrefGeneral" Content="General" Click="TabPrefGeneral_Click" Style="{StaticResource PrefTabButtonStyle}"/>
                                            <Button x:Name="TabPrefMicrophone" Content="Microphone" Click="TabPrefMicrophone_Click" Style="{StaticResource PrefTabButtonStyle}"/>
                                            <Button x:Name="TabPrefVocabulary" Content="Vocabulary" Click="TabPrefVocabulary_Click" Style="{StaticResource PrefTabButtonStyle}"/>
                                            <Button x:Name="TabPrefNarration" Content="Narration" Click="TabPrefNarration_Click" Style="{StaticResource PrefTabButtonStyle}"/>
                                            <Button x:Name="TabPrefIntelligence" Content="Intelligence" Click="TabPrefIntelligence_Click" Style="{StaticResource PrefTabButtonStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Account Header -->
                                    <StackPanel x:Name="AccountHeader" Visibility="Collapsed">
                                        <TextBlock Text="Account" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Manage your subscription and profile." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Login Header -->
                                    <StackPanel x:Name="LoginHeader" Visibility="Collapsed">
                                        <TextBlock Text="Welcome Back" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text="Sign in to access your pro features." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Content Area -->
                                <Grid Grid.Row="1">
                                    <Grid.Resources>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="400" CenterY="300"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Grid.Resources>

                                    <controls:DashboardView x:Name="DashboardViewControl" />
                                    <controls:SmartCommandsView x:Name="SmartCommandsViewControl" Visibility="Collapsed" />
                                    <controls:AccountView x:Name="AccountViewControl" Visibility="Collapsed" />
                                    <controls:LoginView x:Name="LoginViewControl" Visibility="Collapsed" />

                                    <views:MicrophoneView x:Name="MicrophoneViewControl" Visibility="Collapsed" />
                                    <controls:VocabularyView x:Name="VocabularyViewControl" Visibility="Collapsed" />
                                    <controls:NarrationView x:Name="NarrationViewControl" Visibility="Collapsed" />
                                    <controls:IntelligenceView x:Name="IntelligenceViewControl" Visibility="Collapsed" />
                                    <controls:PreferencesView x:Name="PreferencesViewControl" Visibility="Collapsed" />

                                    <controls:CloudLibraryView x:Name="CloudLibraryViewControl" Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
        </Border>





        <!-- Toast Notification Overlay -->
        <Border x:Name="ToastContainer"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,30,0,0"
                Background="{DynamicResource ThemeSurfaceBrush}"
                CornerRadius="12"
                BorderBrush="{DynamicResource ThemeCardBorderHoverBrush}"
                BorderThickness="1"
                Padding="18,10"
                Visibility="Collapsed"
                Opacity="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtToastIcon"
                           Text="&#xE73E;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji, Segoe UI"
                           Foreground="{DynamicResource ThemeAccentBrush}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="15"/>
                <TextBlock x:Name="TxtToastMessage"
                           Text="Preference Saved"
                           Foreground="{DynamicResource ThemeForegroundBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Custom Confirm Delete Overlay -->
        <Grid x:Name="OverlayConfirmDelete" Visibility="Collapsed" Background="#CC050507">
            <Border Background="{DynamicResource ThemeSurfaceBrush}"
                    BorderBrush="{DynamicResource ThemeCardBorderHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28"
                    MinWidth="360">
                <StackPanel>
                    <TextBlock Text="Confirm Deletion"
                               FontFamily="{DynamicResource DisplayFont}"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtConfirmDeleteMessage"
                               Text="Are you sure you want to delete this item?"
                               Foreground="{DynamicResource ThemeSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelDelete_Click"
                                MinWidth="104"
                                Height="38"
                                Margin="0,0,10,0"/>
                        <Button Content="Delete"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ConfirmDelete_Click"
                                MinWidth="104"
                                Height="38"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Secure Mode Overlay -->
        <Grid x:Name="OverlaySecureMode" Visibility="Collapsed" Background="#CC050507">
            <Border Background="{DynamicResource ThemeSurfaceBrush}"
                    BorderBrush="{DynamicResource ThemeDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="36"
                    MaxWidth="480">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource ThemeDangerSubtleBrush}" BorderBrush="{DynamicResource ThemeDangerBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xEA18;" FontSize="26" Foreground="{DynamicResource ThemeDangerBrush}"/>
                    </Border>
                    <TextBlock Text="Secure Erase"
                               FontFamily="{DynamicResource DisplayFont}"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="This will permanently delete ALL vocabulary entries and transcription hints from your database."
                               Foreground="{DynamicResource ThemeDangerBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,6"
                               FontSize="14"/>
                    <TextBlock Text="This action cannot be undone."
                               Foreground="{DynamicResource ThemeSecondaryBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,28"
                               FontSize="13"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelSecureMode_Click"
                                MinWidth="120"
                                Height="40"
                                Margin="0,0,12,0"/>
                        <Button Content="Securely Erase All"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ConfirmSecureMode_Click"
                                MinWidth="160"
                                Height="40"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- VAULT PASSWORD OVERLAY -->
        <Grid x:Name="VaultPasswordOverlay" Visibility="Collapsed" Panel.ZIndex="100" Background="#CC050507">
            <Border x:Name="VaultContent"
                    Width="410"
                    MaxHeight="550"
                    Height="Auto"
                    Background="{DynamicResource ThemeSurfaceBrush}"
                    CornerRadius="18"
                    BorderBrush="{DynamicResource ThemeCardBorderHoverBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                </Border.RenderTransform>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE72E;" FontSize="22" Foreground="{DynamicResource ThemeAccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="TxtVaultTitle"
                                   Text="Secure Your Vault"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtVaultSubtitle"
                                   Text="Enter a password to encrypt your backup. You will need this same password to restore."
                                   Foreground="{DynamicResource ThemeSecondaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock x:Name="LblVaultName" Text="BACKUP NAME (OPTIONAL)" Style="{StaticResource MicroLabelStyle}" Margin="2,0,0,6"/>
                        <TextBox x:Name="TxtVaultName" Height="40" VerticalContentAlignment="Center" Padding="12,0" Margin="0,0,0,16"/>

                        <TextBlock x:Name="LblVaultPassword" Text="VAULT PASSWORD" Style="{StaticResource MicroLabelStyle}" Margin="2,0,0,6"/>
                        <PasswordBox x:Name="TxtVaultPassword" Height="40" VerticalContentAlignment="Center" Padding="12,0"/>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelVault_Click" Grid.Column="0" Height="40"/>
                            <Button x:Name="BtnConfirmVault" Content="Confirm" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmVault_Click" Grid.Column="2" Height="40"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ONBOARDING OVERLAY -->
        <Grid x:Name="OverlayOnboarding" Visibility="Collapsed" Opacity="0" Panel.ZIndex="250" Background="#D9050507">
            <Border x:Name="OnboardingBorder"
                    Width="580"
                    MinHeight="480"
                    Height="Auto"
                    MaxHeight="640"
                    Background="{DynamicResource ThemeSurfaceBrush}"
                    CornerRadius="20"
                    BorderBrush="{DynamicResource ThemeCardBorderHoverBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <!-- STEP 1: WELCOME -->
                    <Grid x:Name="StepWelcome" Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" Margin="48">
                            <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE734;" FontSize="32" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Welcome to CosmoWhisper" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="The most powerful voice interface for Windows. Ready to transform how you work?" Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,36"/>
                            <Button Content="Get Started" Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click" Height="48" FontSize="16"/>
                            <Button Content="Skip Onboarding" Click="OnboardingSkip_Click" Background="Transparent" Foreground="{DynamicResource ThemeMutedBrush}" Margin="0,14,0,0" Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 2: MICROPHONE -->
                    <Grid x:Name="StepMic" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="48">
                            <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE720;" FontSize="32" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Voice Check" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Select your primary microphone and adjust sensitivity." Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="15" TextAlignment="Center" Margin="0,0,0,28"/>

                            <ComboBox x:Name="ComboOnboardingMics" Height="44" FontSize="14" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,30">
                                <TextBlock Text="Sensitivity" Style="{StaticResource MicroLabelStyle}"/>
                                <Slider x:Name="SldOnboardingSensitivity" Margin="0,24,0,0" Maximum="100" Value="2"/>
                            </Grid>

                            <Button Content="Next Step" Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click" Height="46" FontSize="15"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 3: ACTIVATION -->
                    <Grid x:Name="StepActivation" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="48">
                            <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE945;" FontSize="32" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Quick Activation" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Press F9 to activate the voice interface. You can change this shortcut in settings later." Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="15" TextAlignment="Center" Margin="0,0,0,32" TextWrapping="Wrap"/>

                            <Border Style="{StaticResource SubtlePanelStyle}" Padding="24,14" HorizontalAlignment="Center">
                                <TextBlock Text="F9" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="34" FontWeight="ExtraBold"/>
                            </Border>

                            <Button Content="Next: Smart Features" Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click" Height="48" FontSize="16" Margin="0,34,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 4: VOCABULARY -->
                    <Grid x:Name="StepVocabulary" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="48">
                            <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE8F1;" FontSize="32" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Train Your AI" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Add names, technical jargon, and acronyms to your personal Vocabulary. CosmoWhisper learns your language for 100% accuracy." Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="15" TextAlignment="Center" Margin="0,0,0,34" TextWrapping="Wrap"/>
                            <Button Content="Next Step" Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click" Height="48" FontSize="16"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 5: INTELLIGENCE -->
                    <Grid x:Name="StepIntelligence" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="48">
                            <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE756;" FontSize="32" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Intelligent Actions" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="It's more than dictation. Use AI to rewrite emails, fix grammar, or summarize documents instantly with voice commands." Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="15" TextAlignment="Center" Margin="0,0,0,34" TextWrapping="Wrap"/>
                            <Button Content="Next Step" Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click" Height="48" FontSize="16"/>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 6: LIBRARY -->
                    <Grid x:Name="StepLibrary" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="48">
                            <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE774;" FontSize="32" Foreground="{DynamicResource ThemeAccentBrush}"/>
                            </Border>
                            <TextBlock Text="Global Command Center" FontFamily="{DynamicResource DisplayFont}" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Sync your commands to the cloud and browse the community library for powerful pre-built workflows." Foreground="{DynamicResource ThemeSecondaryBrush}" FontSize="15" TextAlignment="Center" Margin="0,0,0,34" TextWrapping="Wrap"/>
                            <Button Content="Finish Setup" Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingComplete_Click" Height="48" FontSize="16"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="UniversalDialog" Visibility="Collapsed" Opacity="0" Panel.ZIndex="200">
            <!-- Modal Backdrop Scrim -->
            <Border Background="#CC050507" MouseDown="UniversalDialog_MouseDown"/>

            <!-- Dialog Card -->
            <Border x:Name="DialogContent"
                    Width="430"
                    MinHeight="210"
                    MaxHeight="640"
                    Background="{DynamicResource ThemeSurfaceBrush}"
                    CornerRadius="18"
                    BorderBrush="{DynamicResource ThemeCardBorderHoverBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DialogScale" ScaleX="0.9" ScaleY="0.9"/>
                </Border.RenderTransform>

                <StackPanel Margin="32,34,32,30">
                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource ThemeAccentSubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock x:Name="TxtDialogIcon"
                                   Text="&#xE946;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji, Segoe UI"
                                   Foreground="{DynamicResource ThemeAccentBrush}"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TxtDialogTitle"
                               Text="Success"
                               FontFamily="{DynamicResource DisplayFont}"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="TxtDialogMessage"
                               Text="Your environment is now secured."
                               Foreground="{DynamicResource ThemeSecondaryBrush}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,20"
                               LineHeight="21"/>

                    <!-- Input Field (Optional) -->
                    <TextBox x:Name="TxtDialogInput"
                             Visibility="Collapsed"
                             Height="44"
                             Padding="14,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,22"/>

                    <!-- Selection List (Optional) -->
                    <ListBox x:Name="ListDialogOptions"
                             Visibility="Collapsed"
                             Background="{DynamicResource ThemeInputBgBrush}"
                             BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                             BorderThickness="1"
                             MaxHeight="200"
                             Margin="0,0,0,22"
                             Foreground="{DynamicResource ThemeForegroundBrush}"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeHoverSurfaceBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnDialogCancel"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="DialogCancel_Click"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Height="44"
                                Visibility="Collapsed"/>

                        <Button x:Name="BtnDialogConfirm"
                                Content="Confirm"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="DialogConfirm_Click"
                                Grid.Column="1"
                                Grid.ColumnSpan="1"
                                Height="44"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</Window>
















