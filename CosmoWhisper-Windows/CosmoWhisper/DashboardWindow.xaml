<Window x:Class="CosmoWhisper.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Managers="clr-namespace:CosmoWhisper.Managers"
        Title="CosmoWhisper Dashboard" Height="600" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12" Margin="8,4">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <!-- Left Accent Line (Hidden by default) -->
                                <Border x:Name="AccentLine" Width="4" Height="20" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource ThemeGlowBrush}" Opacity="0" Margin="-4,0,0,0"/>
                                
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                            <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#60FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="AccentLine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="AccentLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1AFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.98" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.98" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb Background="#40FFFFFF" Opacity="0.5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMPREHENSIVE DARK COMBOBOX STYLE -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252A3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path x:Name="Arrow" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#353A4D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="10,3,30,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1A1C30" BorderThickness="1" BorderBrush="#40FFFFFF" CornerRadius="8"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="#1A1C30"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#1A1C30"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- PREMIUM AMBIENT NEBULA BACKGROUND -->
        <Canvas x:Name="CosmicBackground" IsHitTestVisible="False">
            <!-- Deep Space Base -->
            <Rectangle Width="2000" Height="2000" Canvas.Left="-500" Canvas.Top="-500">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5">
                        <GradientStop Color="{DynamicResource ThemeBgStartColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource ThemeBgMidColor}" Offset="0.7"/>
                        <GradientStop Color="{DynamicResource ThemeBgEndColor}" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Simplified Gradient Only (Blobs Removed) -->
        </Canvas>



        <!-- Premium Glass Container -->
        <Border x:Name="RootContentBorder" CornerRadius="30" Margin="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#B21E293B" Offset="0"/> <!-- 70% opacity premium slate -->
                    <GradientStop Color="#CC0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#40FFFFFF" Offset="0"/>
                    <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#30FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" Color="Black" Opacity="0.5" ShadowDepth="0"/>
            </Border.Effect>
            <Border BorderBrush="#1AFFFFFF" BorderThickness="1.2" CornerRadius="30">
                <Grid x:Name="MainContainer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top Edge highlight for physical depth -->
                    <Border Height="1" VerticalAlignment="Top" Margin="30,1,30,0" Background="#30FFFFFF" Grid.ColumnSpan="2"/>

                    <!-- Sidebar (Menu) -->
                    <Border Grid.Column="0" CornerRadius="30,0,0,30" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40FFFFFF" Offset="0"/> <!-- Light top sheen -->
                                <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                                <GradientStop Color="#20000000" Offset="1"/> <!-- Dark bottom shadow -->
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Premium Logo Section (Pinned Top) -->
                            <StackPanel Grid.Row="0" Margin="10,35,20,25">
                                <Image Source="sidebar_logo.png" Width="42" Height="42" HorizontalAlignment="Left" Margin="22,0,0,12" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect Color="{DynamicResource ThemeGlowColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                    </Image.Effect>
                                </Image>
                                <StackPanel Margin="22,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Cosmo" FontSize="18" FontWeight="ExtraBold" Foreground="#00F7FF">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#00F7FF" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="Whisper" FontSize="18" FontWeight="ExtraBold" Foreground="#BF5AF2" Margin="2,0,0,0">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#BF5AF2" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Height="2" Width="40" Background="#4000F7FF" HorizontalAlignment="Left" Margin="2,4,0,0" CornerRadius="1"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Scrollable Navigation (Main Body) -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,0,20,10">
                                    <!-- Main Navigation -->
                                    <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButton}" Click="Dashboard_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F4CA;" Foreground="#00F7FF" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnSmartCommands" Style="{StaticResource SidebarButton}" Click="SmartCommands_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x26A1;" Foreground="#FFD700" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Smart Commands" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Separator Background="#10FFFFFF" Margin="20,15" Height="1"/>
                                    
                                    <!-- Settings Group -->
                                    <TextBlock Text="SETTINGS" Margin="22,5,0,12" Foreground="White" Opacity="0.3" FontSize="10" FontWeight="ExtraBold"/>
                                    <Button x:Name="BtnMicrophone" Style="{StaticResource SidebarButton}" Click="Microphone_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F3A4;" Foreground="#FF453A" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Microphone" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnVocabulary" Style="{StaticResource SidebarButton}" Click="Vocabulary_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F5E3;" Foreground="#32D74B" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Vocabulary" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnNarration" Style="{StaticResource SidebarButton}" Click="Narration_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F50A;" Foreground="#BF5AF2" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Narration" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnIntelligence" Style="{StaticResource SidebarButton}" Click="Intelligence_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F9E0;" Foreground="#FF9F0A" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Intelligence" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- Preferences Group + Appearance Hooked In -->
                                    <Button x:Name="BtnPreferences" Style="{StaticResource SidebarButton}" Click="Preferences_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2699;" Foreground="#64D2FF" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Preferences" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Themes (Appearance) - Moved here per request -->
                                    <StackPanel Orientation="Horizontal" Margin="42,5,10,15">
                                        <Button Width="26" Height="26" Margin="3" ToolTip="Ocean Blue" Click="ThemeOcean_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="13" Background="#20FFFFFF" x:Name="ThemeBorder">
                                                        <Ellipse Fill="#3b82f6" Margin="4"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThemeBorder" Property="Background" Value="#40FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="26" Height="26" Margin="3" ToolTip="Sunset Glow" Click="ThemeSunset_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="13" Background="#20FFFFFF" x:Name="ThemeBorder">
                                                        <Ellipse Fill="#ec4899" Margin="4"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThemeBorder" Property="Background" Value="#40FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="26" Height="26" Margin="3" ToolTip="Forest Night" Click="ThemeForest_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="13" Background="#20FFFFFF" x:Name="ThemeBorder">
                                                        <Ellipse Fill="#10b981" Margin="4"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThemeBorder" Property="Background" Value="#40FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="26" Height="26" Margin="3" ToolTip="Purple Dream" Click="ThemePurple_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="13" Background="#20FFFFFF" x:Name="ThemeBorder">
                                                        <Ellipse Fill="#9333ea" Margin="4"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThemeBorder" Property="Background" Value="#40FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <Button x:Name="BtnLibrary" Style="{StaticResource SidebarButton}" Click="Library_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F4DA;" Foreground="#5E5CE6" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Library" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnLanguage" Style="{StaticResource SidebarButton}" Click="Language_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F310;" Foreground="#FF375F" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Language" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnAccount" Style="{StaticResource SidebarButton}" Click="Account_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F464;" Foreground="#0A84FF" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Account" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Footer Section (Pinned Bottom) -->
                            <StackPanel Grid.Row="2" Margin="10,0,20,30">
                                <Separator Background="#10FFFFFF" Margin="20,0,20,15" Height="1"/>
                                <Button Style="{StaticResource SidebarButton}" Click="Exit_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F6AA;" Foreground="#FF453A" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Exit App" Foreground="#FF453A" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Version 2.2.3-PRO" Foreground="White" Opacity="0.3" FontSize="10" HorizontalAlignment="Center" Margin="0,15,10,0"/>
                                <TextBlock Text="CosmoWhisper Native" Foreground="White" Opacity="0.15" FontSize="9" HorizontalAlignment="Center" Margin="0,2,10,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content (Window) -->
                    <Border Grid.Column="1" CornerRadius="0,30,30,0">
                        <!-- THEME 1: OCEAN BLUE (Default) -->
                        <!-- Change x:Name to switch themes: ThemeOcean, ThemeSunset, ThemeForest, ThemePurple -->
                        <Border.Background>
                            <DynamicResource ResourceKey="ThemeBackgroundBrush"/>
                        </Border.Background>
                        
                        <!-- THEME 2: SUNSET GLOW -->
                        <!--
                        <Border.Background>
                            <LinearGradientBrush x:Name="ThemeSunset" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A1A2E" Offset="0"/>
                                <GradientStop Color="#16213E" Offset="0.3"/>
                                <GradientStop Color="#0F3460" Offset="0.6"/>
                                <GradientStop Color="#E94560" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        -->
                        
                        <!-- THEME 3: FOREST NIGHT -->
                        <!--
                        <Border.Background>
                            <LinearGradientBrush x:Name="ThemeForest" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A1F1F" Offset="0"/>
                                <GradientStop Color="#134E4A" Offset="0.5"/>
                                <GradientStop Color="#065F46" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        -->
                        
                        <!-- THEME 4: PURPLE DREAM -->
                        <!--
                        <Border.Background>
                            <LinearGradientBrush x:Name="ThemePurple" StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A0B2E" Offset="0"/>
                                <GradientStop Color="#2D1B4E" Offset="0.5"/>
                                <GradientStop Color="#4A1C6F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        -->
                        
                        <Grid>
                            
                            <!-- Content Grid -->
                            <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <!-- Dashboard Header -->
                            <StackPanel x:Name="DashboardHeader">
                                <TextBlock Text="Productivity" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Your dictation efficiency at a glance." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>
                            
                            <!-- Smart Commands Header (Hidden by default) -->
                            <StackPanel x:Name="SmartCommandsHeader" Visibility="Collapsed">
                                <TextBlock Text="Smart Commands" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Voice-activated shortcuts for your active text field." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Microphone Header (Hidden by default) -->
                            <StackPanel x:Name="MicrophoneHeader" Visibility="Collapsed">
                                <TextBlock Text="Audio Input" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Manage your recording hardware." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Vocabulary Header -->
                            <StackPanel x:Name="VocabularyHeader" Visibility="Collapsed">
                                <TextBlock Text="Personal Dictionary" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Teach CosmoWhisper your names and specific terminology." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Narration Header (Hidden by default) -->
                            <StackPanel x:Name="NarrationHeader" Visibility="Collapsed">
                                <TextBlock Text="Voice &amp; Narration" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Fine-tune how AI reads text back to you." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>
                            <!-- Intelligence Header -->
                            <StackPanel x:Name="IntelligenceHeader" Visibility="Collapsed">
                                <TextBlock Text="Intelligence" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="Configure your AI Provider and Personality." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Preferences Header -->
                            <StackPanel x:Name="PreferencesHeader" Visibility="Collapsed">
                                <TextBlock Text="Preferences" Foreground="White" FontSize="32" FontWeight="Bold"/>
                                <TextBlock Text="System configuration and backups." Foreground="White" Opacity="0.6" FontSize="14"/>
                            </StackPanel>

                            <!-- Language Header -->
                            <StackPanel x:Name="LanguageHeader" Visibility="Collapsed">
