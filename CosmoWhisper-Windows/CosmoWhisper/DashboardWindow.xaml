                                                    <TextBlock Text="&#x1F504;" FontSize="12" Opacity="0.7" Margin="0,0,10,0"/>
                                                    <TextBlock Text="TRANSCRIPTIONS" Foreground="White" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="StatTranscriptions" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SmartCommandsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
