                                        </StackPanel>
                                    </Border>

                                    <!-- The Cloner (Copy) -->
                                    <Border Width="220" Height="130" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
