                                                    <TextBlock x:Name="TxtUsageLabel" Text="Usage Limit Removed" Foreground="White" Opacity="0.6" FontSize="12"/>
                                                </StackPanel>
                                                
                                                <TextBlock x:Name="TxtUsageStats" Text="1.7 / &#x221E;" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="250,0,0,0"/>
                                            </StackPanel>

                                            <!-- Progress Bar -->
                                            <Grid Grid.Row="1">
