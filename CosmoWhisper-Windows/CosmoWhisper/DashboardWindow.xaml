                                                          <TextBlock Text="AES" Foreground="#00FF90" Opacity="0.7" FontSize="10" VerticalAlignment="Bottom" Margin="2,0,15,4"/>
                                                          <Button x:Name="BtnRestore" Content="Restore from Vault" Click="BtnRestore_Click" Background="#20FFFFFF" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0">
                                                              <Button.Resources>
                                                                  <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                                                              </Button.Resources>
                                                          </Button>
                                                          <Button x:Name="BtnBackupNow" Content="Back up now" Click="BtnBackupNow_Click" Background="#007AFF" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0">
                                                              <Button.Resources>
                                                                  <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                                                              </Button.Resources>
                                                          </Button>
                                                      </StackPanel>
                                                  </Grid>
                                              </StackPanel>
                                         </Border>
                                     </StackPanel>
                                 </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 8: LANGUAGE -->
                            <ScrollViewer x:Name="LanguageView" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Language Selection -->
                                    <TextBlock Text="Interface Language" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="Select Language" Foreground="White" Opacity="0.6" Margin="0,0,0,10" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="ComboLanguage" SelectedIndex="0" Padding="10" Foreground="White" BorderThickness="0" SelectionChanged="ComboLanguage_SelectionChanged">
                                                <ComboBoxItem Content="&#x1F1EC;&#x1F1E7; English (UK)" Tag="en-GB" IsSelected="True"/>
                                                <ComboBoxItem Content="&#x1F1FA;&#x1F1F8; English (US)" Tag="en-US"/>
                                                <ComboBoxItem Content="&#x1F1EA;&#x1F1F8; Espa&#xF1;ol (Spanish)" Tag="es-ES"/>
                                                <ComboBoxItem Content="&#x1F1EB;&#x1F1F7; Fran&#xE7;ais (French)" Tag="fr-FR"/>
                                                <ComboBoxItem Content="&#x1F1E9;&#x1F1EA; Deutsch (German)" Tag="de-DE"/>
                                                <ComboBoxItem Content="&#x1F1E8;&#x1F1F3; &#x4E2D;&#x6587; (Chinese)" Tag="zh-CN"/>
                                                <ComboBoxItem Content="&#x1F1EF;&#x1F1F5; &#x65E5;&#x672C;&#x8A9E; (Japanese)" Tag="ja-JP"/>
                                                <ComboBoxItem Content="&#x1F1F5;&#x1F1F9; Portugu&#xEA;s (Portuguese)" Tag="pt-PT"/>
                                                <ComboBoxItem Content="&#x1F1EE;&#x1F1F3; &#x939;&#x93F;&#x928;&#x94D;&#x926;&#x940; (Hindi)" Tag="hi-IN"/>
                                                <ComboBoxItem Content="&#x1F1F8;&#x1F1E6; &#x627;&#x644;&#x639;&#x631;&#x628;&#x64A;&#x629; (Arabic)" Tag="ar-SA"/>
                                                <ComboBoxItem Content="&#x1F1FF;&#x1F1E6; Afrikaans" Tag="af-ZA"/>
                                            </ComboBox>
                                            <TextBlock Text="Changes will take effect after restarting the application." Foreground="White" Opacity="0.4" FontSize="11" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Date & Time Formatting -->
                                    <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F4C5; Date &amp; Time Formatting" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                            <TextBlock Text="Choose the format for inserted dates (e.g. via 'Insert Date' command)." Foreground="White" Opacity="0.5" FontSize="12" Margin="0,0,0,10"/>
                                            <ComboBox x:Name="ComboDateTime" SelectedIndex="0" Padding="10" Foreground="White" BorderThickness="0" SelectionChanged="ComboDateTime_SelectionChanged">
                                                <ComboBoxItem Content="31/01/2026 (UK/EU)" Tag="dd/MM/yyyy"/>
                                                <ComboBoxItem Content="01/31/2026 (US)" Tag="MM/dd/yyyy"/>
                                                <ComboBoxItem Content="2026-01-31 (ISO)" Tag="yyyy-MM-dd"/>
                                                <ComboBoxItem Content="31 January 2026 (Long UK)" Tag="dd MMMM yyyy"/>
                                                <ComboBoxItem Content="January 31, 2026 (Long US)" Tag="MMMM dd, yyyy"/>
                                                <ComboBoxItem Content="Sat, 31 Jan 2026 (Short Text)" Tag="ddd, dd MMM yyyy"/>
                                                <ComboBoxItem Content="Saturday, 31 January 2026 (Full)" Tag="dddd, dd MMMM yyyy"/>
                                                <ComboBoxItem Content="17:30 (24 Hour Time)" Tag="HH:mm"/>
                                                <ComboBoxItem Content="5:30 PM (12 Hour Time)" Tag="h:mm tt"/>
                                                <ComboBoxItem Content="31/01/2026 17:30 (Date &amp; Time UK)" Tag="dd/MM/yyyy HH:mm"/>
                                                <ComboBoxItem Content="01/31/2026 5:30 PM (Date &amp; Time US)" Tag="MM/dd/yyyy h:mm tt"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Regional Spelling (English Only) -->
                                    <Border x:Name="RegionalSpellingBorder" Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F4DD; Regional Spelling" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                            <Grid Margin="0,0,0,15">
                                                <StackPanel>
                                                    <TextBlock Text="Auto-Convert Spelling After Transcription" Foreground="White" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Automatically converts transcribed text to match your regional spelling preference." Foreground="White" Opacity="0.5" FontSize="12"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleRegionalSpelling" MouseLeftButtonDown="ToggleRegionalSpelling_Click" HorizontalAlignment="Right" Width="44" Height="24" CornerRadius="12" Background="#007AFF" Cursor="Hand">
                                                    <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Right" Margin="2"/>
                                                </Border>
                                            </Grid>
                                            
                                            <!-- Examples -->
                                            <Border Background="#15FFFFFF" CornerRadius="8" Padding="15">
                                                <StackPanel>
                                                    <TextBlock Text="Examples:" Foreground="White" Opacity="0.6" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="&#x1F1FA;&#x1F1F8; US English" Foreground="#007AFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; color" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; center" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; organize" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; realize" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="&#x2194;" Foreground="White" Opacity="0.3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="&#x1F1EC;&#x1F1E7; UK English" Foreground="#007AFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; colour" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; centre" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; organise" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="&#x2022; realise" Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>



                                    <!-- Language Info -->
                                    <Border Background="#15FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F310; How Language Settings Work" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                          <TextBlock Text="&#x2022; Interface Language: Changes menu labels, buttons, and UI text&#x0a;&#x2022; Regional Spelling: Converts transcribed text to match your spelling preference&#x0a;&#x2022; Voice Recognition: Works in all languages regardless of UI language" 
                                                       Foreground="White" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Coming Soon Features -->
                                    <Border Background="#10007AFF" BorderBrush="#30007AFF" BorderThickness="1" CornerRadius="12" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#3B82F6" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,15,0">
                                              <TextBlock Text="&#x2728;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Coming Soon" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                              <TextBlock Text="&#x2022; Regional date and time formats&#x0a;&#x2022; Custom language packs&#x0a;&#x2022; Community translations" 
                                                           Foreground="White" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 9: LIBRARY (CLOUD) -->
                            <ScrollViewer x:Name="LibraryView" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <Border Background="#252A3D" CornerRadius="20" Padding="40" Margin="0,0,0,30">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F310;" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                            <TextBlock Text="Cloud Library" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Explore the full master list of commands online." Foreground="White" Opacity="0.6" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                                            <Button Content="Open Master Commands List" Background="#007AFF" Foreground="White" BorderThickness="0" Padding="30,15" FontWeight="Bold" Cursor="Hand" Click="OpenLibraryWeb_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <TextBlock Text="Includes system triggers, formatting rules, and AI personas." Foreground="White" Opacity="0.4" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Quick Link 1 -->
                                        <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="15" Padding="25" Cursor="Hand" MouseLeftButtonDown="VisitDocs_Click">
                                            <StackPanel>
                                                <TextBlock Text="&#x1F4D6;" FontSize="24" Margin="0,0,0,10"/>
                                                <TextBlock Text="User Manual" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                                <TextBlock Text="Learn how to master dictation." Foreground="White" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Quick Link 2 -->
                                        <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="15" Padding="25" Cursor="Hand" MouseLeftButtonDown="VisitGitHub_Click">
                                            <StackPanel>
                                                <TextBlock Text="&#x1F4BB;" FontSize="24" Margin="0,0,0,10"/>
                                                <TextBlock Text="Open Source" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                                <TextBlock Text="View source and contribute." Foreground="White" Opacity="0.5" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 10: ACCOUNT -->
                            <ScrollViewer x:Name="AccountView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Profile Card -->
                                    <Border Background="#252A3D" CornerRadius="12" Padding="30" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="64" Height="64" CornerRadius="32" Background="#007AFF" Margin="0,0,20,0">
                                                <TextBlock x:Name="AccountTierIcon" Text="CW" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Cosmo User" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="AccountTierStatus" Text="Free Tier" Foreground="#00E676" FontSize="14"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Sign Out" Background="#20FFFFFF" Foreground="White" BorderThickness="0" Padding="15,8" Click="SignOut_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Subscription Info -->
                                    <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="SUBSCRIPTION" Foreground="White" Opacity="0.5" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                                            
                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Plan" Foreground="White" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="AccountUsageLabel" Text="Free Starter" Foreground="White" Opacity="0.6" FontSize="12"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Upgrade to Pro" Background="#007AFF" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="Bold">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>

                                            <Border Height="1" Background="#20FFFFFF" Margin="0,10,0,15"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Usage This Month" Foreground="White" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="AccountUsageStats" Text="0 / 23 minutes used" Foreground="White" Opacity="0.6" FontSize="12"/>
                                                </StackPanel>
                                                <!-- Progress Bar Background -->
                                                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="4" Background="#30FFFFFF" CornerRadius="2" Margin="0,25,0,0">
                                                    <Border x:Name="AccountUsageProgressBar" HorizontalAlignment="Left" Width="0" Background="#007AFF" CornerRadius="2"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- License Key -->
                                    <Border Background="#10FFFFFF" CornerRadius="12" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="LICENSE KEY" Foreground="White" Opacity="0.5" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <TextBlock Text="Have a license key? Enter it here to unlock features." Foreground="White" Opacity="0.6" FontSize="12" Margin="0,0,0,10"/>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtLicense" Background="#20FFFFFF" Foreground="White" Padding="10" BorderThickness="0" FontSize="14" FontFamily="Consolas"/>
                                                <Button Grid.Column="1" Content="Activate" Background="#30FFFFFF" Foreground="White" BorderThickness="0" Padding="15,0" Margin="10,0,0,0" FontWeight="SemiBold" Click="ActivateLicense_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 11: LOGIN -->
                            <ScrollViewer x:Name="LoginView" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                                <StackPanel VerticalAlignment="Center" Margin="0,50,0,0">
                                    <Border Background="#252A3D" CornerRadius="20" Padding="40" HorizontalAlignment="Center" Width="400">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F44B;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                            <TextBlock Text="Welcome Back" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Sign in to your CosmoWhisper account" Foreground="White" Opacity="0.6" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                                            <TextBlock Text="Email Address" Foreground="White" Opacity="0.7" FontSize="12" Margin="0,0,0,8"/>
                                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,20">
                                                <TextBox x:Name="TxtLoginEmail" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"/>
                                            </Border>

                                            <TextBlock Text="Password" Foreground="White" Opacity="0.7" FontSize="12" Margin="0,0,0,8"/>
                                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,30">
                                                <PasswordBox x:Name="TxtLoginPassword" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"/>
                                            </Border>

                                            <Button Content="Sign In" Background="#007AFF" Foreground="White" BorderThickness="0" Padding="0,15" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="PerformLogin_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            
                                            <Button Content="Create an Account" Background="Transparent" Foreground="#007AFF" BorderThickness="0" Margin="0,20,0,0" FontSize="12" Cursor="Hand" Click="SignUp_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Close Button -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Foreground="White" Width="30" Height="30" Content="&#x2715;" Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>


        <!-- Premium Toast Notification Overlay -->
        <Border x:Name="ToastContainer" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0" 
                Background="#1A1C30" CornerRadius="12" BorderBrush="#007AFF" BorderThickness="1" Padding="20,12" 
                Visibility="Collapsed" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtToastIcon" Text="✨" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16"/>
                <TextBlock x:Name="TxtToastMessage" Text="Preference Saved!" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>




