                                    </Grid>

                                    <!-- Stats Cards Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Total Words -->
                                        <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12" Height="100" Margin="0,0,10,0" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" Opacity="0.9">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.1"/>
                                            </Border.Effect>
                                            <StackPanel VerticalAlignment="Center" Margin="25,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBlock Text="&#x1F4AC;" FontSize="12" Opacity="0.7" Margin="0,0,10,0"/>
                                                    <TextBlock Text="TOTAL WORDS" Foreground="White" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="StatTotalWords" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Time Saved -->
                                        <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="12" Height="100" Margin="5,0,5,0" BorderBrush="{DynamicResource ThemeSecondaryBrush}" BorderThickness="1" Opacity="0.9">
