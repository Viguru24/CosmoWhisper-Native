                        <StackPanel VerticalAlignment="Center" Margin="50">
                            <TextBlock Text="ðŸ¤–" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="Intelligent Actions" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="It's more than dictation. Use AI to rewrite emails, fix grammar, or summarize documents instantly with voice commands." Foreground="White" Opacity="0.7" FontSize="16" TextAlignment="Center" Margin="0,0,0,40" TextWrapping="Wrap"/>
                            
                            <Button Content="Next Step" Click="OnboardingNext_Click" Height="55" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" FontWeight="Bold" FontSize="18" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- STEP 6: LIBRARY -->
                    <Grid x:Name="StepLibrary" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="50">
                            <TextBlock Text="ðŸ›¸" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="Global Command Center" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Sync your commands to the cloud and browse the community library for powerful pre-built workflows." Foreground="White" Opacity="0.7" FontSize="16" TextAlignment="Center" Margin="0,0,0,40" TextWrapping="Wrap"/>
                            
                            <Button Content="Finish Setup" Click="OnboardingComplete_Click" Height="55" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" FontWeight="Bold" FontSize="18" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="UniversalDialog" Visibility="Collapsed" Opacity="0" Panel.ZIndex="200">

            <!-- Background Backdrop with Blur -->

            <Border Background="#99000000" MouseDown="UniversalDialog_MouseDown">

                <Border.Effect>

                    <BlurEffect Radius="15"/>

                </Border.Effect>

            </Border>

            

            <!-- Dialog Box -->

            <Border x:Name="DialogContent" Width="440" MinHeight="220" MaxHeight="650" Background="#1C1E32" CornerRadius="28" BorderBrush="#35FFFFFF" BorderThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,10">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.6" ShadowDepth="0"/>

                </Border.Effect>

                <Border.RenderTransform>

                    <ScaleTransform x:Name="DialogScale" ScaleX="0.9" ScaleY="0.9"/>

                </Border.RenderTransform>

                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>



                <Grid>

                    <!-- Background Glow -->

                    <Ellipse Width="300" Height="200" Fill="{DynamicResource ThemeAccentBrush}" Opacity="0.1" VerticalAlignment="Top" Margin="0,-100,0,0">

                        <Ellipse.Effect>

                            <BlurEffect Radius="100"/>

                        </Ellipse.Effect>

                    </Ellipse>



                    <StackPanel Margin="35,40,35,35">

                        <TextBlock x:Name="TxtDialogIcon" Text="?" Foreground="White" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock x:Name="TxtDialogTitle" Text="Success" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" TextAlignment="Center">

                            <TextBlock.Effect>

                                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.3"/>

                            </TextBlock.Effect>

                        </TextBlock>

                        <TextBlock x:Name="TxtDialogMessage" Text="Your environment is now secured." Foreground="White" Opacity="0.75" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15" LineHeight="22"/>



                        <!-- Selection List (Optional) -->

                        <ListBox x:Name="ListDialogOptions" Visibility="Collapsed" Background="#2A2D45" BorderThickness="0" MaxHeight="200" Margin="0,0,0,25" Foreground="White" SelectionMode="Single">

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">

                                    <Setter Property="Padding" Value="10,8"/>

                                    <Setter Property="Margin" Value="0,2"/>

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="ListBoxItem">

                                                <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8">

                                                    <ContentPresenter />

                                                </Border>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">

                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#40FFFFFF"/>

                                                    </Trigger>

                                                    <Trigger Property="IsSelected" Value="True">

                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>

                                                        <Setter Property="Foreground" Value="White"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </ListBox.ItemContainerStyle>

                        </ListBox>

                        

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            

                            <Button x:Name="BtnDialogCancel" Content="Cancel" Click="DialogCancel_Click" Grid.Column="0" Margin="0,0,12,0" Background="#15FFFFFF" Foreground="White" BorderThickness="0" Height="50" Visibility="Collapsed" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CancelBorder" Background="{TemplateBinding Background}" CornerRadius="14" BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CancelBorder" Property="Background" Value="#30FFFFFF"/>
                                                <Setter TargetName="CancelBorder" Property="BorderBrush" Value="#50FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CancelBorder" Property="Background" Value="#10FFFFFF"/>
                                                <Setter TargetName="CancelBorder" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button x:Name="BtnDialogConfirm" Content="Confirm" Click="DialogConfirm_Click" Grid.Column="1" Grid.ColumnSpan="1" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="50" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ConfirmBorder" Background="{TemplateBinding Background}" CornerRadius="14" BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ConfirmBorder" Property="Opacity" Value="1.0"/>
                                                <Setter TargetName="ConfirmBorder" Property="BorderBrush" Value="{DynamicResource ThemeGlowBrush}"/>
                                                <Setter TargetName="ConfirmBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{Binding Color, Source={StaticResource ThemeGlowBrush}}" BlurRadius="15" Opacity="0.6" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ConfirmBorder" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>


















