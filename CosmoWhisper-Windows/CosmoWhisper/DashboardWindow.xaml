                                                    <TextBlock Text="Agent will speak to confirm plan updates" Foreground="White" Opacity="0.6" FontSize="11"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleManusNarration" HorizontalAlignment="Right" Width="40" Height="24" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="12" MouseLeftButtonDown="ToggleManusNarration_Click" Cursor="Hand">
                                                    <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Right" Margin="3"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Personality -->
                                    <Border Background="#15FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F5E8; AI Personality / Verbosity" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                            <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>
                                                  <Button x:Name="BtnConcise" Grid.Column="0" Content="Concise" Margin="0,0,5,0" Background="#10FFFFFF" Foreground="White" BorderThickness="0" Height="40" Click="Personality_Click" Tag="Concise"/>
                                                  <Button x:Name="BtnBalanced" Grid.Column="1" Content="Balanced" Margin="5,0,5,0" Background="#60A060" Foreground="White" BorderThickness="0" Height="40" Click="Personality_Click" Tag="Balanced"/>
                                                  <Button x:Name="BtnDetailed" Grid.Column="2" Content="Detailed" Margin="5,0,0,0" Background="#10FFFFFF" Foreground="White" BorderThickness="0" Height="40" Click="Personality_Click" Tag="Detailed"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 6: VOCABULARY -->
                            <ScrollViewer x:Name="VocabularyView" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Hints -->
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Transcription Hints" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content="✨ Load Examples" Click="LoadExamples_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#15FFFFFF" Foreground="White" Opacity="0.6" BorderThickness="0" Padding="10,5" FontSize="11">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="List names, acronyms, or brands often mistranscribed. Separate with commas." Foreground="White" Opacity="0.5" FontSize="12" Margin="0,0,0,15"/>
                                    
                                    <Border Background="#10FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,30">
                                         <Grid>
                                             <TextBox x:Name="TxtVocabHints" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" Panel.ZIndex="2" TextChanged="TxtVocabHints_TextChanged"/>
                                             <TextBlock x:Name="PlaceholderVocabHints" Text="Example: Batman, Arkham, Wayne Enterprises..." Foreground="White" Opacity="0.4" IsHitTestVisible="False" Panel.ZIndex="1" Margin="2,0,0,0"/>
                                         </Grid>
                                    </Border>

                                    <!-- Corrections Header -->
                                    <Grid Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="Instant Corrections" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="Force specific words to always be changed after transcription." Foreground="White" Opacity="0.5" FontSize="12"/>
                                        </StackPanel>
                                        <Button Content="&#x1F6E1; Secure Mode" Click="SecureMode_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#15FFFFFF" Foreground="White" Opacity="0.6" BorderThickness="0" Padding="10,5" FontSize="12">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="15"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Input Row -->
                                    <Border Background="#10FFFFFF" CornerRadius="25" Padding="5" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- New Input Left -->
                                            <Grid Grid.Column="0" Margin="15,0,0,0">
                                                <TextBox x:Name="TxtNewKey" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" VerticalAlignment="Center" Panel.ZIndex="2" TextChanged="TxtNewInput_TextChanged"/>
                                                <TextBlock x:Name="PlaceholderKey" Text="When I say..." Foreground="White" Opacity="0.4" VerticalAlignment="Center" Panel.ZIndex="1" IsHitTestVisible="False"/>
                                            </Grid>

                                            <!-- Arrow -->
                                            <TextBlock Grid.Column="1" Text="&#x203A;" Foreground="White" Opacity="0.3" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="20"/>
                                            
                                            <!-- New Input Right -->
                                            <Grid Grid.Column="2">
                                                <TextBox x:Name="TxtNewValue" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" VerticalAlignment="Center" Panel.ZIndex="2" TextChanged="TxtNewInput_TextChanged"/>
                                                <TextBlock x:Name="PlaceholderValue" Text="Type this..." Foreground="White" Opacity="0.4" VerticalAlignment="Center" Panel.ZIndex="1" IsHitTestVisible="False"/>
                                            </Grid>

                                            <!-- Add Button -->
                                            <Button Grid.Column="3" Content="Add" Click="AddVocabulary_Click" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" BorderThickness="0" Width="60" Height="34" Margin="5" FontWeight="SemiBold">
                                                 <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="17"/>
                                                    </Style>
                                                 </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- List -->
                                    <ItemsControl x:Name="VocabList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- READ MODE -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}" Visibility="{Binding ReadModeVisibility}"
                                                                   Foreground="White" Opacity="0.7" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Visibility="{Binding ReadModeVisibility}"
                                                                   Foreground="{DynamicResource ThemeGlowBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding ReadModeVisibility}">
                                                            <Button Click="EditVocabulary_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0" ToolTip="Edit">
                                                                <TextBlock Text="✎" Foreground="White" Opacity="0.6" FontSize="14"/>
                                                            </Button>
                                                            <Button Click="DeleteVocabulary_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Delete">
                                                                <Border Background="#20FF453A" CornerRadius="8" Width="24" Height="24">
                                                                     <TextBlock Text="&#x2715;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF453A" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- EDIT MODE -->
                                                        <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditModeVisibility}"
                                                                 Background="#20000000" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="2"
                                                                 Foreground="White" CaretBrush="White" VerticalAlignment="Center"/>
                                                        
                                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditModeVisibility}"
                                                                 Background="#20000000" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="2"
                                                                 Foreground="White" CaretBrush="White" VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding EditModeVisibility}">
                                                            <Button Click="SaveVocabulary_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,5,0" ToolTip="Save">
                                                                <TextBlock Text="✓" Foreground="#4ADE80" FontSize="16" FontWeight="Bold"/>
                                                            </Button>
                                                            <Button Click="CancelVocabulary_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cancel">
                                                                <TextBlock Text="✕" Foreground="#F87171" FontSize="16" FontWeight="Bold"/>
                                                            </Button>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="&#x203A;" Foreground="White" Opacity="0.3" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 7: PREFERENCES -->
                            <ScrollViewer x:Name="PreferencesView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Activation Methods -->
                                    <TextBlock Text="Activation Methods" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                         <StackPanel>
                                             <Grid>
                                                 <StackPanel>
                                                     <TextBlock Text="Activation Shortcut" Foreground="White" FontWeight="SemiBold"/>
                                                     <TextBlock Text="Hold or press this key to record your voice." Foreground="White" Opacity="0.5" FontSize="12"/>
                                                 </StackPanel>
                                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                     <Border Background="#15FFFFFF" CornerRadius="5" Padding="20,8">
                                                         <TextBlock x:Name="TxtHotkey" Text="F9" Foreground="White" FontWeight="Bold"/>
                                                     </Border>
                                                     <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                         <TextBlock Text="EDIT CODE" MouseLeftButtonDown="BtnEditHotkey_Click" Foreground="#FF453A" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                                                         <TextBlock Text="CLEAR" MouseLeftButtonDown="BtnClearHotkey_Click" Foreground="#FF453A" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="0,2,0,0"/>
                                                     </StackPanel>
                                                 </StackPanel>
                                             </Grid>
                                             <Separator Opacity="0.1" Margin="0,15"/>
                                             <!-- Mouse Button -->
                                             <Grid>
                                                 <StackPanel>
                                                     <TextBlock Text="Mouse Button Activation" Foreground="White" FontWeight="SemiBold"/>
                                                     <TextBlock Text="Use any mouse button (Middle, Side, etc) to record." Foreground="White" Opacity="0.5" FontSize="12"/>
                                                 </StackPanel>
                                                 <Border x:Name="ToggleMouseButton" MouseLeftButtonDown="ToggleMouseButton_Click" HorizontalAlignment="Right" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource ThemeAccentBrush}" Cursor="Hand">
                                                    <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Right" Margin="2"/>
                                                 </Border>
                                             </Grid>
                                             <!-- Mouse Configuration -->
                                             <TextBlock Text="Mouse Button Configuration" Foreground="White" FontWeight="SemiBold" Margin="0,15,0,5"/>
                                             <Border x:Name="MouseConfigBorder" Background="#10000000" CornerRadius="5" Padding="10" BorderBrush="#20FFFFFF" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="MouseConfigBorder_Click">
                                                  <Grid>
                                                      <TextBlock x:Name="TxtMouseConfig" Text="Click to configure..." Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                      <TextBlock Text="CLEAR" MouseLeftButtonDown="BtnClearMouse_Click" Foreground="#FF453A" FontSize="10" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                  </Grid>
                                             </Border>
                                             <TextBlock Text="Click the box above, then press any mouse button. The app will automatically detect and save it." Foreground="White" Opacity="0.4" FontSize="10" Margin="0,5,0,0"/>
                                         </StackPanel>
                                    </Border>

                                    <!-- Insertion Method -->
                                    <TextBlock Text="Insertion Method" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BtnFastPaste" MouseLeftButtonDown="FastPaste_Click" Grid.Column="0" Background="#30007AFF" BorderBrush="#007AFF" BorderThickness="2" CornerRadius="10" Padding="15" Cursor="Hand">
                                            <StackPanel>
                                                <TextBlock Text="Fast Paste (Default)" Foreground="White" FontWeight="Bold"/>
                                                <TextBlock Text="Uses clipboard. Instant" Foreground="White" Opacity="0.6" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="BtnDirectType" MouseLeftButtonDown="DirectType_Click" Grid.Column="2" Background="#10FFFFFF" CornerRadius="10" Padding="15" Cursor="Hand" Opacity="0.6">
                                             <StackPanel>
                                                <TextBlock Text="Direct Typing" Foreground="White" FontWeight="Bold"/>
                                                <TextBlock Text="Simulates keyboard. No clipboard." Foreground="White" Opacity="0.6" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                     <!-- Toggles -->
                                     <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                         <StackPanel>
                                             <Grid Margin="0,0,0,15">
                                                 <StackPanel>
                                                     <TextBlock Text="Restore Clipboard Content" Foreground="White" FontWeight="SemiBold"/>
                                                     <TextBlock Text="Automatically put back your old copied text after a voice paste." Foreground="White" Opacity="0.5" FontSize="12"/>
                                                 </StackPanel>
                                                 <Border x:Name="ToggleClipboard" MouseLeftButtonDown="ToggleClipboard_Click" HorizontalAlignment="Right" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource ThemeAccentBrush}" Cursor="Hand">
                                                    <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Right" Margin="2"/>
                                                 </Border>
                                             </Grid>
                                             <Separator Opacity="0.1" Margin="0,0,0,15"/>
                                             <Grid>
                                                 <StackPanel>
                                                     <TextBlock Text="Auto-Submit (Press Enter)" Foreground="White" FontWeight="SemiBold"/>
                                                     <TextBlock Text="Press Enter after inserting text." Foreground="White" Opacity="0.5" FontSize="12"/>
                                                 </StackPanel>
                                                  <Border x:Name="ToggleAutoSubmit" MouseLeftButtonDown="ToggleAutoSubmit_Click" HorizontalAlignment="Right" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource ThemeAccentBrush}" Cursor="Hand">
                                                     <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Right" Margin="2"/>
                                                  </Border>
                                              </Grid>
                                              <Separator Opacity="0.1" Margin="0,15"/>
                                              <Grid>
                                                  <StackPanel>
                                                      <TextBlock Text="Auto-Copy Transcription" Foreground="White" FontWeight="SemiBold"/>
                                                      <TextBlock Text="Automatically copy processed text to your clipboard." Foreground="White" Opacity="0.5" FontSize="12"/>
                                                  </StackPanel>
                                                   <Border x:Name="ToggleAutoCopy" MouseLeftButtonDown="ToggleAutoCopy_Click" HorizontalAlignment="Right" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource ThemeAccentBrush}" Cursor="Hand">
                                                     <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Right" Margin="2"/>
                                                  </Border>
                                              </Grid>
                                          </StackPanel>
                                      </Border>

                                      <!-- Widget Appearance -->
                                      <TextBlock Text="Widget &amp; UI Appearance" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>
                                      <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                          <StackPanel>
                                              <Grid Margin="0,0,0,5">
                                                  <TextBlock Text="Widget Transparency" Foreground="White" FontWeight="SemiBold"/>
                                                  <TextBlock x:Name="TxtWidgetOpacityValue" Text="95%" Foreground="{DynamicResource ThemeGlowBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                              </Grid>
                                              <Slider x:Name="SldWidgetOpacity" Minimum="20" Maximum="100" Value="95" Margin="0,5,0,0" ValueChanged="SldWidgetOpacity_ValueChanged"/>
                                              <TextBlock Text="Adjust how see-through the floating widget appears." Foreground="White" Opacity="0.4" FontSize="10" Margin="0,5,0,20"/>

                                              <Grid Margin="0,0,0,5">
                                                  <TextBlock Text="Global UI Scale (DPI Adjustment)" Foreground="White" FontWeight="SemiBold"/>
                                                  <TextBlock x:Name="TxtUIScaleValue" Text="100%" Foreground="{DynamicResource ThemeGlowBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                              </Grid>
                                              <Slider x:Name="SldUIScale" Minimum="80" Maximum="200" Value="100" Margin="0,5,0,0" ValueChanged="SldUIScale_ValueChanged"/>
                                              <TextBlock Text="Scale the entire interface if fonts appear too small on high resolution screens." Foreground="White" Opacity="0.4" FontSize="10" Margin="0,5,0,0"/>
                                          </StackPanel>
                                      </Border>

                                     <!-- Security & Backup -->
                                     <StackPanel Margin="0,0,0,20">
                                         <TextBlock Text="&#x1F512; Security &amp; Backup" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
                                         <TextBlock Text="A 'Vault' is a total snapshot of your environment. We secure:" Foreground="White" Opacity="0.6" FontSize="12" Margin="0,0,0,15"/>
                                         
                                         <!-- Lists -->
                                         <Grid Margin="0,0,0,20">
                                              <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="*"/>
                                                  <ColumnDefinition Width="*"/>
                                              </Grid.ColumnDefinitions>
                                              <StackPanel>
                                                  <TextBlock Text="&#x2022; Voice Studio: Speed, Pitch &amp; Selection" Foreground="#00FF90" FontSize="11"/>
                                                  <TextBlock Text="&#x2022; Intelligence: API Keys &amp; AI Models" Foreground="#00FF90" FontSize="11" Margin="0,5,0,0"/>
                                                  <TextBlock Text="&#x2022; Setup: Mic ID &amp; Calibration" Foreground="#00FF90" FontSize="11" Margin="0,5,0,0"/>
                                              </StackPanel>
                                               <StackPanel Grid.Column="1">
                                                  <TextBlock Text="&#x2022; Shortcuts: Hotkeys &amp; Mouse Buttons" Foreground="#00FF90" FontSize="11"/>
                                                  <TextBlock Text="&#x2022; Vocabulary: Corrections &amp; Hints" Foreground="#00FF90" FontSize="11" Margin="0,5,0,0"/>
                                                  <TextBlock Text="&#x2022; Workflow: Auto-Submit &amp; Mode" Foreground="#00FF90" FontSize="11" Margin="0,5,0,0"/>
                                              </StackPanel>
                                         </Grid>

                                         <Border Background="#15FFFFFF" CornerRadius="8" Padding="15">
                                              <StackPanel>
                                                  <Grid>
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto"/>
                                                          <ColumnDefinition Width="*"/>
                                                          <ColumnDefinition Width="Auto"/>
                                                      </Grid.ColumnDefinitions>
                                                      <Border Background="#20FFFFFF" CornerRadius="6" Width="30" Height="30" Margin="0,0,15,0">
                                                          <TextBlock Text="&#x1F4BE;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                      </Border>
                                                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                          <TextBlock Text="BACKUP DIRECTORY" Foreground="White" Opacity="0.4" FontSize="10" FontWeight="Bold"/>
                                                          <TextBlock x:Name="TxtBackupPath" Text="C:\Users\...\CosmoWhisper\Backups" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                      </StackPanel>
                                                      <Button Grid.Column="2" x:Name="BtnChangeBackup" Content="Change" Click="BtnChangeBackup_Click" Background="#20FFFFFF" Foreground="White" BorderThickness="0" Padding="15,5">
                                                           <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style>
                                                           </Button.Resources>
                                                      </Button>
                                                  </Grid>
                                                  
                                                  <Separator Opacity="0.1" Margin="0,15"/>
                                                  
                                                  <Grid>
                                                      <StackPanel>
                                                          <TextBlock Text="Local Backup" Foreground="White" FontWeight="Bold"/>
                                                          <TextBlock Text="Last full snapshot size" Foreground="White" Opacity="0.5" FontSize="11"/>
                                                      </StackPanel>
                                                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                          <TextBlock Text="256-BIT" Foreground="#00FF90" FontWeight="Bold" FontSize="18"/>
                                                          <TextBlock Text="AES" Foreground="#00FF90" Opacity="0.7" FontSize="10" VerticalAlignment="Bottom" Margin="2,0,15,4"/>
                                                          <Button x:Name="BtnRestore" Content="Restore from Vault" Click="BtnRestore_Click" Background="#20FFFFFF" Foreground="White" Padding="15,10" Margin="0,0,10,0" BorderThickness="0">
                                                              <Button.Resources>
                                                                  <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                                                              </Button.Resources>
                                                          </Button>
                                                          <Button x:Name="BtnBackupNow" Content="Back up now" Click="BtnBackupNow_Click" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0">
                                                              <Button.Resources>
                                                                  <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                                                              </Button.Resources>
                                                          </Button>
                                                      </StackPanel>
                                                  </Grid>
                                              </StackPanel>
                                         </Border>
                                     </StackPanel>
                                 </StackPanel>
                            </ScrollViewer>

                            <!-- VIEW 8: LANGUAGE -->
                            <ScrollViewer x:Name="LanguageView" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Language Selection -->
                                    <TextBlock Text="Interface Language" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="Select Language" Foreground="White" Opacity="0.6" Margin="0,0,0,10" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="ComboLanguage" SelectedIndex="0" Padding="10" Foreground="White" BorderThickness="0" SelectionChanged="ComboLanguage_SelectionChanged">
                                                <ComboBoxItem Content="&#x1F1EC;&#x1F1E7; English (UK)" Tag="en-GB" IsSelected="True"/>
                                                <ComboBoxItem Content="&#x1F1FA;&#x1F1F8; English (US)" Tag="en-US"/>
                                                <ComboBoxItem Content="&#x1F1EA;&#x1F1F8; Espa&#xF1;ol (Spanish)" Tag="es-ES"/>
                                                <ComboBoxItem Content="&#x1F1EB;&#x1F1F7; Fran&#xE7;ais (French)" Tag="fr-FR"/>
                                                <ComboBoxItem Content="&#x1F1E9;&#x1F1EA; Deutsch (German)" Tag="de-DE"/>
                                                <ComboBoxItem Content="&#x1F1E8;&#x1F1F3; &#x4E2D;&#x6587; (Chinese)" Tag="zh-CN"/>
                                                <ComboBoxItem Content="&#x1F1EF;&#x1F1F5; &#x65E5;&#x672C;&#x8A9E; (Japanese)" Tag="ja-JP"/>
                                                <ComboBoxItem Content="&#x1F1F5;&#x1F1F9; Portugu&#xEA;s (Portuguese)" Tag="pt-PT"/>
                                                <ComboBoxItem Content="&#x1F1EE;&#x1F1F3; &#x939;&#x93F;&#x928;&#x94D;&#x926;&#x940; (Hindi)" Tag="hi-IN"/>
                                                <ComboBoxItem Content="&#x1F1F8;&#x1F1E6; &#x627;&#x644;&#x639;&#x631;&#x628;&#x64A;&#x629; (Arabic)" Tag="ar-SA"/>
                                                <ComboBoxItem Content="&#x1F1FF;&#x1F1E6; Afrikaans" Tag="af-ZA"/>
                                            </ComboBox>
                                            <TextBlock Text="Changes will take effect after restarting the application." Foreground="White" Opacity="0.4" FontSize="11" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Date & Time Formatting -->
                                    <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="&#x1F4C5; Date &amp; Time Formatting" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                            <TextBlock Text="Choose the format for inserted dates (e.g. via 'Insert Date' command)." Foreground="White" Opacity="0.5" FontSize="12" Margin="0,0,0,10"/>
                                            <ComboBox x:Name="ComboDateTime" SelectedIndex="0" Padding="10" Foreground="White" BorderThickness="0" SelectionChanged="ComboDateTime_SelectionChanged">
                                                <ComboBoxItem Content="31/01/2026 (UK/EU)" Tag="dd/MM/yyyy"/>
                                                <ComboBoxItem Content="01/31/2026 (US)" Tag="MM/dd/yyyy"/>
                                                <ComboBoxItem Content="2026-01-31 (ISO)" Tag="yyyy-MM-dd"/>
                                                <ComboBoxItem Content="31 January 2026 (Long UK)" Tag="dd MMMM yyyy"/>
                                                <ComboBoxItem Content="January 31, 2026 (Long US)" Tag="MMMM dd, yyyy"/>
