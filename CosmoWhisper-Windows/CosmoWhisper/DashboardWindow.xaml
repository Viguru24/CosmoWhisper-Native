                            <!-- VIEW 3: MICROPHONE (Hidden by default) -->
                            <ScrollViewer x:Name="MicrophoneView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Active Microphone -->
                                    <TextBlock Text="Active Microphone" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <Border Background="#252A3D" CornerRadius="12" Padding="5" Margin="0,0,0,25">
                                        <ComboBox x:Name="ComboMics" Foreground="White" BorderThickness="0" FontSize="14" Padding="10" SelectionChanged="ComboMics_SelectionChanged">
                                            <!-- Dynamic Mics Loaded in Code Behind -->
                                        </ComboBox>
                                    </Border>

                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F399;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Live Monitor" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtMicLevel" Text="0%" HorizontalAlignment="Right" Foreground="#00E676" FontWeight="Bold" FontSize="12"/>
                                        </Grid>
                                        <Grid Height="12" Width="350" HorizontalAlignment="Left">
                                            <Border Background="#20FFFFFF" CornerRadius="6"/>
                                            <Border x:Name="LiveMonitorBar" HorizontalAlignment="Left" Width="0" CornerRadius="6">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#007AFF" Offset="0"/>
                                                        <GradientStop Color="#00FFD4" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00D4FF" BlurRadius="12" Opacity="0.5" ShadowDepth="0"/>
                                                </Border.Effect>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="If the bar doesn't move when you speak, check Windows settings or select the correct device above." Foreground="White" Opacity="0.4" FontSize="10" Margin="0,8,0,0"/>


                                    <!-- Microphone Sensitivity -->
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Microphone Sensitivity" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="2%" HorizontalAlignment="Right" Foreground="#007AFF" FontWeight="Bold" FontSize="14"/>
                                    </Grid>
                                    <TextBlock Text="Higher values strictly filter background noise. Lower values pick up whispers." Foreground="White" Opacity="0.6" FontSize="12" Margin="0,0,0,15"/>
                                    
                                    <Slider x:Name="SldSensitivity" Maximum="100" Value="2" Margin="0,0,0,5" ValueChanged="SldSensitivity_ValueChanged"/> 
                                    <!-- Note: Default slider style might not match perfectly without custom template, using standard for now but styled logic would go here -->
                                    <Grid Margin="0,0,0,25">
                                        <TextBlock Text="Sensitive (Whisper)" Foreground="White" Opacity="0.4" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Strict (Loud)" Foreground="White" Opacity="0.4" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Neural Auto-Calibration -->
                                    <Border Background="#10007AFF" BorderBrush="#30007AFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,25">
                                        <Border.Style>
                                             <Style TargetType="Border">
                                                 <!-- Simple dashed border attempt using visual brush or properties if supported, WPF Border doesn't support generic DashType easily without drawing brush. 
                                                      We will simulate stroke dash array on a rectangle or use a specific style. For now, solid blue border. -->
                                             </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Neural Auto-Calibration" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                                <TextBlock Text="Measure room noise to find the perfect sensitivity automatically." Foreground="White" Opacity="0.6" FontSize="12"/>
                                            </StackPanel>
                                            <Button x:Name="BtnCalibrate" Grid.Column="1" Content="&#x26A1; Calibrate" Background="#007AFF" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="SemiBold" Click="BtnCalibrate_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </Button.Resources>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Interaction Sounds -->
                                    <Border Background="#15FFFFFF" CornerRadius="12" Padding="20">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Interaction Sounds" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                                <TextBlock Text="Play chimes when recording starts and stops" Foreground="White" Opacity="0.6" FontSize="12"/>
                                            </StackPanel>
                                            <!-- Simple Toggle Switch Representation -->
                                            <Border x:Name="ToggleInteractionSounds" Grid.Column="1" HorizontalAlignment="Right" Width="40" Height="24" Background="#007AFF" CornerRadius="12" MouseLeftButtonDown="ToggleInteractionSounds_Click" Cursor="Hand">
                                                <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Right" Margin="3"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>


                            <!-- VIEW 4: NARRATION (Hidden by default) -->
                            <ScrollViewer x:Name="NarrationView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    
                                    <!-- Pro Banner -->
                                    <Border BorderBrush="#30007AFF" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,25">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#203B82F6" Offset="0"/>
                                                <GradientStop Color="#053B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#3B82F6" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,15,0">
                                                <TextBlock Text="&#x26A1;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="PRO TIP: High-Quality Free &amp; Paid Voices" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                                <TextBlock Text="Use Premier (&#x2728;) for the best free local voices or use an API key for Neural (&#x1F310;) paid cloud voices." Foreground="White" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Voice Selection -->
                                    <TextBlock Text="&#x1F50A; Voice Selection" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                    <Border Background="#10FFFFFF" CornerRadius="10" Padding="5" Margin="0,0,0,25">
                                        <ComboBox x:Name="ComboVoice" Foreground="White" BorderThickness="0" FontSize="14" Padding="10" SelectionChanged="ComboVoice_SelectionChanged">
                                            <!-- Dynamic Voices Loaded in Code Behind -->
                                        </ComboBox>
                                    </Border>

                                    <!-- API Key -->
                                    <StackPanel Margin="0,0,0,25">
                                        <TextBlock Text="⚡ OpenAI API Key (Required for Paid Neural Voices)" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#15FFFFFF" CornerRadius="8" Padding="15,10">
                                                <PasswordBox x:Name="TxtApiKey" PasswordChar="•" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"/>
                                            </Border>
                                            <Button Grid.Column="1" Content="Get Key" Margin="10,0,0,0" Background="#20FFFFFF" Foreground="White" BorderThickness="0" Padding="15,0" FontWeight="SemiBold">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="Your key is stored locally on this device." Foreground="White" Opacity="0.4" FontSize="10" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Split View: Fine-Tuning & Playground -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Fine-Tuning -->
                                        <Border Grid.Column="0" Background="#10FFFFFF" CornerRadius="12" Padding="20">
                                            <StackPanel>
                                                <TextBlock Text="&#x1F6E0; Fine-Tuning" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>
                                                
                                                <!-- Speed -->
                                                <Grid Margin="0,0,0,5">
                                                    <TextBlock Text="Narration Speed" Foreground="White" Opacity="0.7" FontSize="12"/>
                                                    <TextBlock x:Name="TxtSpeedValue" Text="1.0" Foreground="#007AFF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                                                </Grid>
                                                <Slider x:Name="SldSpeed" Minimum="0.25" Maximum="4.0" Value="1.0" Margin="0,0,0,20" ValueChanged="SldSpeed_ValueChanged"/>

                                                <!-- Volume -->
                                                <Grid Margin="0,0,0,5">
                                                    <TextBlock Text="Narration Volume" Foreground="White" Opacity="0.7" FontSize="12"/>
                                                    <TextBlock x:Name="TxtVolumeValue" Text="100%" Foreground="#007AFF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                                                </Grid>
                                                <Slider x:Name="SldVolume" Minimum="0" Maximum="100" Value="100" Margin="0,0,0,20" ValueChanged="SldVolume_ValueChanged"/>

                                                <!-- Pitch -->
                                                <Grid Margin="0,0,0,5">
                                                    <TextBlock Text="Voice Pitch" Foreground="White" Opacity="0.7" FontSize="12"/>
                                                    <TextBlock x:Name="TxtPitchValue" Text="1.0" Foreground="#007AFF" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12"/>
                                                </Grid>
                                                <Slider x:Name="SldPitch" Minimum="0.5" Maximum="2.0" Value="1.0" Margin="0,0,0,0" ValueChanged="SldPitch_ValueChanged"/>

                                            </StackPanel>
                                        </Border>

                                        <!-- Playground -->
                                        <Border Grid.Column="2" Background="#10FFFFFF" CornerRadius="12" Padding="20">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="&#x25B7; Test Playground" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                                                
                                                <Border Grid.Row="1" Background="#15FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                                                    <TextBox x:Name="TxtPlayground" Text="Hello! I am your CosmoWhisper assistant. How can I help you today?" 
                                                             Background="Transparent" BorderThickness="0" Foreground="White" 
                                                             TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/>
                                                </Border>

                                                <Grid Grid.Row="2">
