<Window x:Class="CosmoWhisper.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Managers="clr-namespace:CosmoWhisper.Managers"
        mc:Ignorable="d"
        Title="CosmoWhisper Widget" 
        Height="100" Width="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="500" Top="20"
        MouseDown="Window_MouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Path=Preferences.UIScale, Source={x:Static Managers:PreferenceManager.Shared}}" 
                           ScaleY="{Binding Path=Preferences.UIScale, Source={x:Static Managers:PreferenceManager.Shared}}"/>
        </Grid.LayoutTransform>
        
        <!-- Capsule Background -->
        <Border CornerRadius="30" BorderThickness="1.5" x:Name="MainBorder">
            <Border.RenderTransform>
                <ScaleTransform x:Name="MainBorderScale" CenterX="120" CenterY="40"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.5" ShadowDepth="0" RenderingBias="Performance"/>
            </Border.Effect>
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.2" Center="0.5,0.2" RadiusX="1.5" RadiusY="1">
                    <GradientStop Color="#CC0B1026" Offset="0"/>
                    <GradientStop Color="#CC050510" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="BorderGradient" StartPoint="0.1,0.1" EndPoint="0.9,0.9">
                    <GradientStop Color="#8800F7FF" Offset="0"/>
                    <GradientStop Color="#22FFFFFF" Offset="0.3"/>
                    <GradientStop Color="#88BF5AF2" Offset="0.7"/>
                    <GradientStop Color="#44FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid ClipToBounds="True">
                <!-- Shooting Star Effect -->
                <Grid x:Name="StarLayer" Opacity="0.8">
                    <Canvas>
                        <Ellipse Width="1" Height="1" Fill="White" Canvas.Left="30" Canvas.Top="20"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="70" Canvas.Top="45" Opacity="0.6"/>
                        <Ellipse Width="1" Height="1" Fill="White" Canvas.Left="150" Canvas.Top="15"/>
                        <Ellipse Width="1.5" Height="1.5" Fill="White" Canvas.Left="190" Canvas.Top="50" Opacity="0.4"/>
                        <Ellipse Width="1" Height="1" Fill="White" Canvas.Left="110" Canvas.Top="35"/>
                    </Canvas>

                    <!-- Shooting star removed: continuous RepeatBehavior="Forever" + BlurEffect violates <1% idle CPU budget -->
                </Grid>

                <!-- Command Confirmed Ripple Effect (Pulse outwards) -->
                <Ellipse x:Name="RippleEffect" Width="100" Height="100" Opacity="0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#6610B981" Offset="0"/>
                            <GradientStop Color="#2210B981" Offset="0.65"/>
                            <GradientStop Color="#0010B981" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="RippleScale" CenterX="50" CenterY="50" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- UI Content Layer -->
                <Grid Margin="12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Liquid Moon Orb -->
                    <Grid x:Name="MicControl" Cursor="Hand" MouseLeftButtonDown="MicControl_MouseLeftButtonDown" VerticalAlignment="Center" Margin="2,0,8,0">
                        <Grid x:Name="ThinkingAura" Opacity="0">
                            <Ellipse Width="46" Height="46">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#88FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect><BlurEffect Radius="25" RenderingBias="Performance"/></Ellipse.Effect>
                            </Ellipse>
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ThinkingAuraScale" CenterX="23" CenterY="23"/>
                                    <RotateTransform x:Name="ThinkingAuraRotation" CenterX="23" CenterY="23"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                        </Grid>

                        <Ellipse x:Name="OrbCorona" Width="44" Height="44" Opacity="0.3">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#44FFFFFF" Offset="0.2"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect><BlurEffect Radius="20" RenderingBias="Performance"/></Ellipse.Effect>
                        </Ellipse>
                        
                        <Ellipse x:Name="OrbGlow" Width="36" Height="36" Fill="#88FFFFFF" Opacity="0.4">
                            <Ellipse.Effect><BlurEffect Radius="12" RenderingBias="Performance"/></Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="OrbAuraScale" CenterX="18" CenterY="18"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Ellipse x:Name="OrbMain" Width="22" Height="22">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.3" RadiusX="1" RadiusY="1">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="#F0F0F0" Offset="0.3"/>
                                    <GradientStop Color="#D0D0D0" Offset="0.7"/>
                                    <GradientStop Color="#C0C0C0" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="OrbScale" CenterX="11" CenterY="11"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="OrbShadow" BlurRadius="15" Color="White" Opacity="0.5" ShadowDepth="0" RenderingBias="Performance"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Satellite fly-by -->
                        <Canvas Width="44" Height="44" IsHitTestVisible="False">
                            <Ellipse x:Name="SatelliteOrb" Width="5" Height="4" Fill="White" Canvas.Left="40" Canvas.Top="20">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="1" RenderingBias="Performance"/>
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SatelliteRotation" CenterX="-18" CenterY="2"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <!-- Visualizer -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0">
                        <StackPanel x:Name="VisualizerPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                            <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        </StackPanel>

                        <!-- Status/Error Text (NEWly Required by C#) -->
                        <TextBlock x:Name="TxtStatus" Text="{Binding StatusText}" Foreground="OrangeRed" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" FontWeight="Bold"/>

                        <!-- Hotkey Hint (NEW) -->
                        <TextBlock x:Name="TxtHotkeyHint" Text="{Binding HotkeyHint}" Foreground="White" Opacity="0.3" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" IsHitTestVisible="False"/>


                        <!-- Sine Wave Canvas: driven by C# audio level in real-time -->
                        <Canvas x:Name="SineWaveCanvas" Width="120" Height="44" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="SineWavePath"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.92">
                                <Path.Effect>
                                    <BlurEffect Radius="2" RenderingBias="Performance"/>
                                </Path.Effect>
                            </Path>
                            <!-- Glow duplicate for depth -->
                            <Path x:Name="SineWaveGlow"
                                  Stroke="White"
                                  StrokeThickness="4"
                                  Opacity="0.18">
                                <Path.Effect>
                                    <BlurEffect Radius="6" RenderingBias="Performance"/>
                                </Path.Effect>
                            </Path>
                        </Canvas>

                        <!-- Thinking Dots: three white circles that pulse sequentially -->
                        <StackPanel x:Name="ThinkingDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="White" Margin="4,0" Opacity="0.25">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Dot1Scale" CenterX="3.5" CenterY="3.5"/></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.6" RenderingBias="Performance"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="White" Margin="4,0" Opacity="0.25">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Dot2Scale" CenterX="3.5" CenterY="3.5"/></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.6" RenderingBias="Performance"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="White" Margin="4,0" Opacity="0.25">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Dot3Scale" CenterX="3.5" CenterY="3.5"/></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.6" RenderingBias="Performance"/></Ellipse.Effect>
                            </Ellipse>
                        </StackPanel>
                    </Grid>

                    <!-- Gear Button -->
                    <Grid Grid.Column="2" Cursor="Hand" VerticalAlignment="Center" 
                          MouseLeftButtonDown="Gear_MouseLeftButtonDown"
                          MouseRightButtonDown="Gear_MouseRightButtonDown">
                        <Ellipse x:Name="GearBg" Width="36" Height="36" Fill="#1AFFFFFF"/>
                        <Path x:Name="GearIcon" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                              Fill="White" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="GearRotation" Angle="0" CenterX="10" CenterY="10"/>
                            </Path.RenderTransform>
                        </Path>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GearRotation" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="GearBg" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#40FFFFFF" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GearRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="GearBg" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#1AFFFFFF" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

