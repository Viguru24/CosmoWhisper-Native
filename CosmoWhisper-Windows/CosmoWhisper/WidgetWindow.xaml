<Window x:Class="CosmoWhisper.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Managers="clr-namespace:CosmoWhisper.Managers"
        mc:Ignorable="d"
        Title="CosmoWhisper Widget" 
        Height="80" Width="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="500" Top="20"
        MouseDown="Window_MouseDown">
    
    <Window.Resources>
        <!-- Idle Breathing -->
        <Storyboard x:Key="IdleBreathingAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="VisualizerPanel" Storyboard.TargetProperty="Opacity" From="0.3" To="0.8" Duration="0:0:2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Pulse Animation -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbGlow" 
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.7" Duration="0:0:1.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="OrbScale" 
                             Storyboard.TargetProperty="ScaleX"
                             From="0.8" To="1.2" Duration="0:0:1.2" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="OrbScale" 
                             Storyboard.TargetProperty="ScaleY"
                             From="0.8" To="1.2" Duration="0:0:1.2" AutoReverse="True"/>
        </Storyboard>



        <!-- Sound Wave Animation -->
        <Storyboard x:Key="SoundWaveAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Height" From="8" To="30" Duration="0:0:0.4" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Height" From="12" To="35" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="Wave3" Storyboard.TargetProperty="Height" From="16" To="40" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.05"/>
            <DoubleAnimation Storyboard.TargetName="Wave4" Storyboard.TargetProperty="Height" From="10" To="32" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="Wave5" Storyboard.TargetProperty="Height" From="14" To="38" Duration="0:0:0.55" AutoReverse="True" BeginTime="0:0:0.08"/>
        </Storyboard>

        <!-- Command Confirmed Ripple -->
        <Storyboard x:Key="RippleAnimation">
            <DoubleAnimation Storyboard.TargetName="RippleEffect" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="RippleScale" Storyboard.TargetProperty="ScaleX" From="1" To="4" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="RippleScale" Storyboard.TargetProperty="ScaleY" From="1" To="4" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="0">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Path=Preferences.UIScale, Source={x:Static Managers:PreferenceManager.Shared}}" 
                           ScaleY="{Binding Path=Preferences.UIScale, Source={x:Static Managers:PreferenceManager.Shared}}"/>
        </Grid.LayoutTransform>
        
        <!-- Capsule Background -->
        <Border CornerRadius="30" BorderThickness="1.5" x:Name="MainBorder">
            <Border.Background>
                <SolidColorBrush x:Name="MainBgBrush" Color="#0D0D0D" Opacity="0.8"/>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                    <GradientStop Color="#11FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#33FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Opacity="0.5" ShadowDepth="0" Color="Black"/>
            </Border.Effect>

            <Grid Margin="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Mic Orb -->
                    <ColumnDefinition Width="*"/>    <!-- Visualizer/Sound Wave -->
                    <ColumnDefinition Width="Auto"/> <!-- Gear -->
                </Grid.ColumnDefinitions>

                <!-- 1. Mic Orb -->
                <Grid x:Name="MicControl" Cursor="Hand" MouseLeftButtonDown="MicControl_MouseLeftButtonDown" VerticalAlignment="Center">
                    <!-- Ripple Effect Layer -->
                    <Ellipse x:Name="RippleEffect" Width="20" Height="20" Fill="#007AFF" Opacity="0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="RippleScale" CenterX="10" CenterY="10"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    
                    <Ellipse x:Name="OrbGlow" Width="40" Height="40" Fill="#FF007AFF" Opacity="0">
                        <Ellipse.Effect>
                            <BlurEffect Radius="15"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    
                    <Ellipse x:Name="OrbMain" Width="24" Height="24" Fill="#FF007AFF">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="OrbScale" CenterX="12" CenterY="12"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="OrbShadow" BlurRadius="12" Color="#007AFF" Opacity="0.8" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    
                    <!-- Hotkey Active Indicator -->
                    <Border x:Name="HotkeyIndicator" Visibility="Collapsed" Width="10" Height="10" CornerRadius="5" Background="#00FF90" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-2,-2,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" Color="#00FF90" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                </Grid>

                <!-- 2. Visualizer -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0">
                    <StackPanel x:Name="VisualizerPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                        <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#44FFFFFF" Margin="2,0"/>
                    </StackPanel>

                    <StackPanel x:Name="SoundWavePanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle x:Name="Wave1" Width="4" Height="8" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Center">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00D4FF" Offset="0"/><GradientStop Color="#007AFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Wave2" Width="4" Height="12" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Center">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFD4" Offset="0"/><GradientStop Color="#00D4FF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Wave3" Width="4" Height="16" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Center">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF00D4" Offset="0"/><GradientStop Color="#FF007A" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Wave4" Width="4" Height="10" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Center">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD400" Offset="0"/><GradientStop Color="#FF7A00" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="Wave5" Width="4" Height="14" RadiusX="2" RadiusY="2" Margin="2,0" VerticalAlignment="Center">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#7AFF00" Offset="0"/><GradientStop Color="#00FF7A" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- 3. Gear Button -->
                <Grid Grid.Column="2" Cursor="Hand" VerticalAlignment="Center" 
                      MouseLeftButtonDown="Gear_MouseLeftButtonDown"
                      MouseRightButtonDown="Gear_MouseRightButtonDown">
                    <Ellipse x:Name="GearBg" Width="36" Height="36" Fill="#1AFFFFFF"/>
                    <Path x:Name="GearIcon" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                          Fill="White" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="GearRotation" Angle="0" CenterX="10" CenterY="10"/>
                        </Path.RenderTransform>
                    </Path>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="GearRotation" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ColorAnimation Storyboard.TargetName="GearBg" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#40FFFFFF" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="GearRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <ColorAnimation Storyboard.TargetName="GearBg" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="#1AFFFFFF" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
