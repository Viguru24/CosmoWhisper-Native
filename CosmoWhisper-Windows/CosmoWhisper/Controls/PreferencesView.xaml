<UserControl x:Class="CosmoWhisper.Controls.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="2500" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0C0D1A">
        <StackPanel Margin="50,40,50,40">

            <!-- SECTION: ACTIVATION METHODS -->
            <TextBlock Text="Activation Methods" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
            <Border Background="#151728" CornerRadius="20" Padding="30" Margin="0,0,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Activation Trigger" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Set your global shortcut. Hold any key or mouse button to configure." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" Margin="0,0,0,20"/>
                        <TextBlock Text="Cosmo works system-wide. Hold your trigger to speak, release to transcribe." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.3" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="100" Height="60" CornerRadius="15" Background="#20FFFFFF" Cursor="Hand" MouseLeftButtonDown="Hotkey_Click">
                            <TextBlock x:Name="TxtHotkeyControl" Text="F9" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RESET" Foreground="#FF4B4B" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonDown="ResetHotkey_Click"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- SECTION: AUTOMATION & FLOW -->
            <Border Background="#151728" CornerRadius="20" Padding="0" Margin="0,0,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel>
                    <!-- Instant Paste Mode -->
                    <Border Padding="25" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Instant Paste Mode" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Uses Ctrl+V for ultra-fast insertion. Disable for character-by-character 'Natural' typing." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <Border x:Name="TogglePasteModeControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="TogglePasteMode_Click">
                                <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Clipboard -->
                    <Border Padding="25" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Restore Clipboard Content" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Automatically put back your old copied text after a voice paste." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <Border x:Name="ToggleClipboardControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ToggleClipboard_Click">
                                <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Auto Copy -->
                    <Border Padding="25" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Auto-Copy Transcription" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Automatically copy processed text to your clipboard." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <Border x:Name="ToggleAutoCopyControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ToggleAutoCopy_Click">
                                <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Speech Polish (600M Model) -->
                    <Border Padding="25" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="✨ Enhanced Speech Polish (AI Filler &amp; Disfluency Cleanup)" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Automatically removes 'um/uh', vocal hesitations, stutters, and formats speech fluently in real-time." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <Border x:Name="ToggleSpeechPolishControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ToggleSpeechPolish_Click">
                                <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Cloud Proxy -->
                    <Border Padding="25" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Force Cloud Proxy (VPN Mode)" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Always bypass standard API routes and use proxy servers." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <Border x:Name="ToggleForceCloudProxyControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ForceCloudProxy_Click">
                                <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Force Direct API -->
                    <Border Padding="25" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Force Direct API (No Proxy/Fallback)" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Force cloud transcriptions to only use the direct API key, disabling local fallback and backend proxying." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <Border x:Name="ToggleForceDirectApiControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ForceDirectApi_Click">
                                <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Local Voice Engine Selector -->
                    <Border Padding="25">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Local Speech Engine" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Choose between Parakeet Redux (Fast, Accurate) or Whisper Tiny (Lightweight Fallback)." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboLocalVoiceEngineControl" HorizontalAlignment="Right" Width="200" Height="34" SelectionChanged="LocalVoiceEngine_Changed" VerticalAlignment="Center">
                                <ComboBoxItem Content="Parakeet Redux" Tag="ParakeetRedux"/>
                                <ComboBoxItem Content="Whisper Tiny (77MB)" Tag="WhisperTiny"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION: WIDGET & UI -->
            <TextBlock Text="Widget &amp; UI Appearance" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
            <Border Background="#151728" CornerRadius="20" Padding="30" Margin="0,0,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel>
                    <!-- Widget Transparency -->
                    <StackPanel Margin="0,0,0,40">
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Widget Transparency" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Adjust how see-through the floating widget appears." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtWidgetOpacityValueControl" Text="95%" Foreground="#007AFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="SldWidgetOpacityControl" Minimum="10" Maximum="100" Value="95" ValueChanged="WidgetOpacity_Changed"/>
                    </StackPanel>

                    <!-- Global UI Scale -->
                    <StackPanel Margin="0,0,0,40">
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Global UI Scale (DPI Adjustment)" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Scale the entire interface if fonts appear too small on high resolution screens." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtUIScaleValueControl" Text="100%" Foreground="#007AFF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="SldUIScaleControl" Minimum="80" Maximum="150" Value="100" ValueChanged="UIScale_Changed"/>
                    </StackPanel>

                    <!-- Always on Top -->
                    <Border Padding="0,25,0,0" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Always on Top" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Keep the CosmoWhisper window above all other applications." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                            </StackPanel>
                            <Border x:Name="ToggleAlwaysOnTopControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ToggleAlwaysOnTop_Click">
                                <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION: SECURITY & BACKUP -->
            <TextBlock Text="🛡 Security &amp; Backup" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="22" FontWeight="Bold" Margin="0,10,0,10"/>
            <TextBlock Text="&quot;Vault&quot; is a total snapshot of your environment. We secure:" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="15" Margin="0,0,0,20"/>
            
            <UniformGrid Columns="2" Margin="0,0,0,30">
                <TextBlock Text="• Voice Studio: Speed, Pitch &amp; Selection" Foreground="#00FF9D" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="• Shortcuts: Hotkeys &amp; Mouse Buttons" Foreground="#00FF9D" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="• Intelligence: API Keys &amp; AI Models" Foreground="#00FF9D" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="• Vocabulary: Corrections &amp; Hints" Foreground="#00FF9D" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="• Setup: Mic ID &amp; Calibration" Foreground="#00FF9D" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="• Workflow: Auto-Submit &amp; Mode" Foreground="#00FF9D" FontSize="13" Margin="0,0,0,8"/>
            </UniformGrid>

            <Border Background="#151728" CornerRadius="20" Padding="30" Margin="0,0,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="💾" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="32" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="BACKUP DIRECTORY" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.4" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtBackupPathControl" Text="C:\Users\...\CosmoWhisper\Backups" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" Opacity="0.8"/>
                        </StackPanel>
                        
                        <Button Grid.Column="2" Content="Change" Click="ChangeBackupPath_Click" VerticalAlignment="Center" Padding="20,8" Background="#20FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Margin="15,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Local Backup" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Last full snapshot size: --" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.4" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="256-BIT AES ENCRYPTION" Foreground="#00FF9D" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="SECURE VAULT GATEWAY" Foreground="#00FF9D" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Right" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Restore Backup" Click="Restore_Click" Grid.Column="0" Margin="0,0,10,0" Height="45" Background="#25FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnBackupNowControl" Content="Back up now" Click="BackupNow_Click" Grid.Column="1" Height="45" Background="{DynamicResource ThemeSecondaryBrush}" Foreground="#151A2C" BorderThickness="0" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION: DATE & TIME FORMATTING -->
            <Border Background="#151728" CornerRadius="20" Padding="30" Margin="0,0,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🗓 Date &amp; Time Formatting" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Date Format" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboDateFormatControl" Height="45" Background="#10FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Margin="0,0,0,20" SelectionChanged="DateFormat_Changed">
                        <ComboBoxItem Content="31/01/2026 (Short UK)" Tag="dd/MM/yyyy"/>
                        <ComboBoxItem Content="01/31/2026 (Short US)" Tag="MM/dd/yyyy"/>
                        <ComboBoxItem Content="31 January 2026 (Long UK)" Tag="dd MMMM yyyy"/>
                        <ComboBoxItem Content="January 31, 2026 (Long US)" Tag="MMMM dd, yyyy"/>
                    </ComboBox>

                    <TextBlock Text="Time Format" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboTimeFormatControl" Height="45" Background="#10FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" SelectionChanged="TimeFormat_Changed">
                        <ComboBoxItem Content="17:30 (24 Hour Time)" Tag="HH:mm"/>
                        <ComboBoxItem Content="5:30 PM (12 Hour Time)" Tag="h:mm tt"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- SECTION: REGIONAL SPELLING -->
            <Border Background="#151728" CornerRadius="20" Padding="30" Margin="0,0,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="📝 Regional Spelling" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Auto-Convert Spelling After Transcription" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Automatically converts transcribed text to match your regional spelling preference." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                        </StackPanel>
                        <Border x:Name="ToggleRegionalSpellingControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ToggleRegionalSpelling_Click" VerticalAlignment="Center">
                            <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                        </Border>
                    </Grid>

                    <Border Background="#0C0D1A" CornerRadius="12" Padding="20" Margin="0,25,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="US US English" Foreground="#007AFF" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="• color" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                                <TextBlock Text="• center" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                                <TextBlock Text="• organize" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                                <TextBlock Text="• realize" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="⇌" Grid.Column="1" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.3" FontSize="20" VerticalAlignment="Center" Margin="20,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GB UK English" Foreground="#007AFF" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="• colour" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                                <TextBlock Text="• centre" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                                <TextBlock Text="• organise" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                                <TextBlock Text="• realise" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION: WINDOWS INTEGRATION -->
            <Border Background="#151728" CornerRadius="20" Padding="30" Margin="0,0,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="🚀 Windows Integration" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Launch with Windows" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Automatically start CosmoWhisper when you log into Windows." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12"/>
                    </StackPanel>
                    <Border x:Name="ToggleLaunchOnStartupControl" HorizontalAlignment="Right" Width="48" Height="26" CornerRadius="13" Background="#30FFFFFF" Cursor="Hand" MouseLeftButtonDown="ToggleLaunchOnStartup_Click" VerticalAlignment="Center">
                        <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                    </Border>
                </Grid>
            </Border>

            <!-- HIDDEN FIELDS FOR BACKWARD COMPATIBILITY -->
            <TextBlock x:Name="TxtListeningPromptControl" Visibility="Collapsed"/>
            <Border x:Name="ToggleLocalOnlyControl" Visibility="Collapsed"/>
            <TextBlock x:Name="LocalModeStatusTitleControl" Visibility="Collapsed"/>
            <TextBlock x:Name="LocalModeStatusDescControl" Visibility="Collapsed"/>
            <TextBlock x:Name="LocalOverlayIconControl" Visibility="Collapsed"/>
            <PasswordBox x:Name="TxtApiKeyControl" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
