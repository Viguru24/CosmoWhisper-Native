<UserControl x:Class="CosmoWhisper.Controls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CosmoWhisper.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- SECTION: QUICK SETTINGS -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Local vs Cloud Mode -->
                <Border Grid.Column="0" Background="#18181B" CornerRadius="14" Padding="22" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Pretty Circular Orb -->
                        <Border x:Name="ToggleLocalWhisperControl" Width="52" Height="52" CornerRadius="26" Background="#222228" BorderBrush="#33333A" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="ToggleLocalWhisper_Click" HorizontalAlignment="Center">
                            <Grid>
                                <!-- Glow Effect -->
                                <Ellipse x:Name="LocalWhisperGlow" Fill="{DynamicResource ThemeAccentBrush}" Opacity="0.1" Margin="-2"/>
                                <!-- Symbol inside Orb -->
                                <TextBlock x:Name="LocalWhisperIcon" Text="☁" FontSize="26" Foreground="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Dynamic Status Text -->
                        <TextBlock x:Name="TxtLocalWhisperStatus" Text="Connected to Cloud" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Automatic audio translation mode" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Auto Submit Mode -->
                <Border Grid.Column="2" Background="#18181B" CornerRadius="14" Padding="22" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Pretty Circular Orb -->
                        <Border x:Name="ToggleAutoSubmitControl" Width="52" Height="52" CornerRadius="26" Background="#222228" BorderBrush="#33333A" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="ToggleAutoSubmit_Click" HorizontalAlignment="Center">
                            <Grid>
                                <!-- Glow Effect -->
                                <Ellipse x:Name="AutoSubmitGlow" Fill="{DynamicResource ThemeSecondaryBrush}" Opacity="0.1" Margin="-2"/>
                                <!-- Symbol inside Orb -->
                                <TextBlock x:Name="AutoSubmitIcon" Text="✕" FontSize="20" Foreground="{DynamicResource ThemeForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Dynamic Status Text -->
                        <TextBlock x:Name="TxtAutoSubmitStatus" Text="No Enter" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Press Enter after dictating" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Store Lite Banner -->
            <Border x:Name="StoreLiteBanner" Visibility="Collapsed" Background="#18181B" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1" Margin="0,0,0,24">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Background="#202025" BorderBrush="#2E2E35" BorderThickness="1" Width="40" Height="40" CornerRadius="10" Margin="0,0,15,0">
                        <TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource ThemeAccentBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Microsoft Store Edition (Lite)" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Limited to 60 mins/month. Want full access?" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.7" FontSize="13"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="8" Padding="16,8" Cursor="Hand" MouseLeftButtonDown="GetFullAccess_Click" VerticalAlignment="Center">
                        <TextBlock Text="Upgrade at CosmoWhisper.com" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Pro Banner -->
            <Border x:Name="ProBanner" Background="#18181B" CornerRadius="14" BorderBrush="#27272A" BorderThickness="1" Margin="0,0,0,25">
                

                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Background="{DynamicResource ThemeGlowBrush}" Width="32" Height="32" CornerRadius="8" Opacity="0.2" Margin="0,0,15,0">
                            <TextBlock Text="&#x26A1;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeGlowBrush}"/>
                        </Border>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtTierStatus" Text="Pro Unlocked" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="TierIcon" Text="&#x1F513;" Margin="5,0,0,0" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtUsageLabel" Text="Usage Limit Removed" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                        
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="TxtUsageStats" Text="1.7 / &#x221E;" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="Bold" Margin="0,0,0,0"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="1">
                        <Border Height="6" Background="#20FFFFFF" CornerRadius="3"/>
                        <Border x:Name="UsageProgressBar" HorizontalAlignment="Left" Width="300" Height="6" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="3">
                            
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Stats Section Header -->
            <Grid Margin="0,30,0,15">
                <TextBlock Text="Performance Snapshot" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                <Button x:Name="BtnResetStats" HorizontalAlignment="Right" Content="&#x21BA; Reset All" Background="Transparent" Foreground="{DynamicResource ThemeGlowBrush}" BorderThickness="0" Cursor="Hand" Click="ResetStats_Click" FontSize="12" FontWeight="SemiBold"/>
            </Grid>

            <!-- Stats Cards Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Words -->
                <Border Grid.Column="0" Background="#18181B" CornerRadius="12" Height="100" Margin="0,0,10,0" BorderBrush="#27272A" BorderThickness="1">
                    
                    <StackPanel VerticalAlignment="Center" Margin="25,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="•" FontSize="14" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="TOTAL WORDS" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="StatTotalWords" Text="0" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Time Saved -->
                <Border Grid.Column="1" Background="#18181B" CornerRadius="12" Height="100" Margin="5,0,5,0" BorderBrush="#27272A" BorderThickness="1">
                    
                    <StackPanel VerticalAlignment="Center" Margin="25,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="•" FontSize="14" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                            <TextBlock Text="TIME SAVED" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="StatTimeSaved" Text="0h" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Transcriptions -->
                <Border Grid.Column="2" Background="#18181B" CornerRadius="12" Height="100" BorderBrush="#27272A" BorderThickness="1">
                    
                    <StackPanel VerticalAlignment="Center" Margin="25,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="•" FontSize="14" Foreground="#71717A" Margin="0,0,8,0"/>
                            <TextBlock Text="TRANSCRIPTIONS" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="StatTranscriptions" Text="0" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
