<UserControl x:Class="CosmoWhisper.Controls.VocabularyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800">

    <ScrollViewer x:Name="OuterScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="0,4,16,32">

            <!-- Hints & SignOff -->
            <TextBlock Text="Transcription Hints" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
            <TextBlock Text="Keywords that help the AI understand your context." Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,24">
                <TextBox x:Name="TxtVocabHintsControl" Height="100" TextWrapping="Wrap" Padding="14" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                <TextBlock x:Name="PlaceholderVocabHintsControl" Text="Separated by commas: project names, technical terms, proper nouns..." Foreground="{DynamicResource ThemeMutedBrush}" Opacity="0.75" IsHitTestVisible="False" Margin="16,16,16,0"/>
            </Grid>

            <Border Style="{StaticResource CardContainerStyle}" Padding="24" Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Auto Sign-Off" Style="{StaticResource CardTitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                        <TextBlock Text="To activate: say 'Sign off' or 'Regards' at the end of your dictation." Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,14"/>
                        <Grid>
                            <TextBox x:Name="TxtSignatureControl" Height="64" FontSize="13" Padding="12,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                            <TextBlock x:Name="PlaceholderSignatureControl" Text="Enter signature (e.g. - Sent via CosmoWhisper)" Foreground="{DynamicResource ThemeMutedBrush}" Opacity="0.75" IsHitTestVisible="False" FontSize="13" Margin="14,12,14,0"/>
                        </Grid>
                    </StackPanel>

                    <ToggleButton x:Name="ToggleSignOffControl"
                                  Grid.Column="1"
                                  Style="{StaticResource CosmoToggleSwitchStyle}"
                                  VerticalAlignment="Center"
                                  Click="ToggleSignOff_Click"
                                  AutomationProperties.Name="Auto Sign-Off"/>
                </Grid>
            </Border>

            <!-- Custom Phrase Replacements -->
            <TextBlock Text="One Word to Trigger Other Words" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6"/>
            <TextBlock Text="Create custom shortcuts. While dictating, say the Trigger Phrase and Cosmo automatically swaps in the Replacement text." Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource CardContainerStyle}" Padding="24" Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Labels Row -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TRIGGER PHRASE" Style="{StaticResource MicroLabelStyle}" FontSize="10" Margin="2,0,15,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="REPLACEMENT" Style="{StaticResource MicroLabelStyle}" FontSize="10" Margin="2,0,15,8"/>

                    <!-- Inputs Row -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Bottom">
                        <TextBox x:Name="TxtNewKeyControl" Height="44" Padding="14,0" VerticalContentAlignment="Center" TextChanged="TxtNewInput_TextChanged"/>
                        <TextBlock x:Name="PlaceholderKeyControl" Text="e.g. 'CW'" Foreground="{DynamicResource ThemeMutedBrush}" Opacity="0.75" IsHitTestVisible="False" VerticalAlignment="Center" Margin="16,0,12,0"/>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Bottom">
                        <TextBox x:Name="TxtNewValueControl" Height="80" Padding="14,12" VerticalContentAlignment="Top" TextChanged="TxtNewInput_TextChanged" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PlaceholderValueControl" Text="e.g. '1007 Mountain Drive,&#x0a;Gotham City, NJ 07001'" Foreground="{DynamicResource ThemeMutedBrush}" Opacity="0.75" IsHitTestVisible="False" VerticalAlignment="Top" Margin="16,13,12,0"/>
                    </Grid>

                    <Button Grid.Row="1" Grid.Column="2" Content="Add Entry" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddEntry_Click" VerticalAlignment="Bottom" Height="44" Padding="24,0"/>
                </Grid>
            </Border>

            <!-- List Header with Reset Button -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Active Vocabulary" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Reset Defaults" Style="{StaticResource SecondaryButtonStyle}" Click="BtnResetDefaults_Click" Padding="14,7" FontSize="12"/>
            </Grid>

            <ListBox x:Name="VocabListControl"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Foreground="{DynamicResource ThemeForegroundBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     PreviewMouseWheel="VocabListControl_PreviewMouseWheel"
                     Margin="0,0,0,24">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,12" Padding="22,18" MinHeight="80">
                            <Grid>
                                <!-- READ MODE -->
                                <Grid Visibility="{Binding ReadModeVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource CardDescriptionStyle}" Margin="0,6,0,0" LineHeight="20"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="EditVocabulary_Click" Width="34" Height="34" Padding="0" Margin="0,0,8,0" ToolTip="Edit Entry" AutomationProperties.Name="Edit Entry">
                                            <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE70F;" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>

                                        <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteVocabulary_Click" Width="34" Height="34" Padding="0" ToolTip="Delete Entry" AutomationProperties.Name="Delete Entry">
                                            <TextBlock Style="{StaticResource FluentIconStyle}" Text="&#xE74D;" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- EDIT MODE -->
                                <Grid Visibility="{Binding EditModeVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="TRIGGER" Style="{StaticResource MicroLabelStyle}" FontSize="10" Margin="2,0,0,5"/>
                                        <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="REPLACEMENT" Style="{StaticResource MicroLabelStyle}" FontSize="10" Margin="2,0,0,5"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" Padding="10,8" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                        <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Click="SaveVocabulary_Click" Padding="14,8" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelVocabulary_Click" Padding="14,8" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Rectangle Height="48" Fill="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
