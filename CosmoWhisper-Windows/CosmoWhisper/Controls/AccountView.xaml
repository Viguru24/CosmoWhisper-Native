<UserControl x:Class="CosmoWhisper.Controls.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CosmoWhisper.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Profile Card -->
            <Border Background="#252A3D" CornerRadius="12" Padding="30" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ThemeAccentBrush}" Margin="0,0,20,0">
                        <TextBlock x:Name="AccountTierIcon" Text="CW" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountUserName" Text="Cosmo User" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="AccountTierStatus" Text="Free Tier" Foreground="#00E676" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRefreshStatus" Content="🔄" Background="#20FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Padding="12,8" Margin="0,0,10,0" ToolTip="Refresh Account Status" Click="RefreshStatus_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Sign Out" Background="#20FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Padding="15,8" Click="SignOut_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Subscription Info -->
            <Border Background="#10FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="SUBSCRIPTION" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TxtAccountEmail" Text="Not Signed In" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Plan" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" Margin="0,0,0,8"/>
                            <TextBlock x:Name="AccountUsageLabel" Text="Free Starter" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                        <Button x:Name="BtnUpgradeAccount" Grid.Column="1" Content="Upgrade to Pro" Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Padding="15,8" FontWeight="Bold" Click="UpgradeToPro_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <Border Height="1" Background="#20FFFFFF" Margin="0,10,0,15"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,15,0,10">
                            <TextBlock Text="Usage This Month" Foreground="{DynamicResource ThemeForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="AccountUsageStats" Text="0 / 60 minutes used" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Row="1" Height="6" Background="#20FFFFFF" CornerRadius="3" Margin="0,0,0,15">
                            <Border x:Name="AccountUsageProgressBar" HorizontalAlignment="Left" Width="0" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="3">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- License Key -->
            <Border Background="#10FFFFFF" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="LICENSE KEY" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.5" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Have a license key? Enter it here to unlock features." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="12" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLicense" Background="#20FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" Padding="10" BorderThickness="0" FontSize="14" FontFamily="Consolas"/>
                        <Button Grid.Column="1" Content="Activate" Background="#30FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Padding="15,0" Margin="10,0,0,0" FontWeight="SemiBold" Click="ActivateLicense_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Support & Setup -->
            <StackPanel Margin="0,30,0,10">
                <Button Content="Run Setup Again" HorizontalAlignment="Left" Background="Transparent" Foreground="#60FFFFFF" BorderThickness="0" FontSize="12" Click="RestartSetup_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" Cursor="Hand" Opacity="0.5"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Third-Party Licenses & Attribution (CC-BY-4.0 Compliance) -->
            <Border Background="#151728" CornerRadius="16" Padding="20" Margin="0,10,0,30" BorderBrush="#15FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚖️ Open-Source &amp; AI Attribution" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="• Parakeet Redux STT: Moondream / NVIDIA Parakeet-TDT (CC-BY-4.0 Attribution License)." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="11" Margin="0,0,0,3"/>
                    <TextBlock Text="• Whisper.net: whisper.cpp / OpenAI Whisper (MIT License)." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="11" Margin="0,0,0,3"/>
                    <TextBlock Text="• Sherpa-ONNX: Next-gen Kaldi / ONNX Runtime (Apache-2.0 License)." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
