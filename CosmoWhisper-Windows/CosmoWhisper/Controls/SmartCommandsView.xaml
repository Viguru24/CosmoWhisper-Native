<UserControl x:Class="CosmoWhisper.Controls.SmartCommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CosmoWhisper.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Button HorizontalAlignment="Right" Content="&#x1F310; Browse Smart Commands" Background="#15FFFFFF" Foreground="{DynamicResource ThemeForegroundBrush}" BorderThickness="0" Padding="15,8" FontWeight="SemiBold" Click="OpenLibraryWeb_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Text Sorcery Section -->
            <TextBlock Text="&#x2728; Text Sorcery" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,15"/>
            <WrapPanel Margin="0,0,0,30">
                <!-- World Eater (Select All) -->
                <Border Width="220" Height="130" Style="{DynamicResource PremiumTileStyle}" Margin="0,0,10,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3B82F6" Offset="0"/>
                            <GradientStop Color="#FF06B6D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="World Eater" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Select All'" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" Margin="0,4,0,0" FontStyle="Italic"/>
                        <TextBlock Text="Consume every character in the field. Leave nothing behind." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.9" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Apocalypse (Delete All) -->
                <Border Width="220" Height="130" Style="{DynamicResource PremiumTileStyle}" Margin="0,0,10,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFEF4444" Offset="0"/>
                            <GradientStop Color="#FFB91C1C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="Apocalypse" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Delete All'" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" Margin="0,4,0,0" FontStyle="Italic"/>
                        <TextBlock Text="Nuke the field. Start fresh. No regrets." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.9" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- The Cloner (Copy) -->
                <Border Width="220" Height="130" Style="{DynamicResource PremiumTileStyle}" Margin="0,0,10,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF8B5CF6" Offset="0"/>
                            <GradientStop Color="#FF6D28D9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="The Cloner" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Copy That'" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" Margin="0,4,0,0" FontStyle="Italic"/>
                        <TextBlock Text="Steal it. Stash it. It's yours now." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.9" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Manifest (Paste) -->
                <Border Width="220" Height="130" Style="{DynamicResource PremiumTileStyle}" Margin="0,0,10,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF10B981" Offset="0"/>
                            <GradientStop Color="#FF059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="Manifest" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Paste That'" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" Margin="0,4,0,0" FontStyle="Italic"/>
                        <TextBlock Text="Dump the payload. Bring it into reality." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.9" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Time Travel (Undo) -->
                <Border Width="220" Height="130" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF59E0B" Offset="0"/>
                            <GradientStop Color="#FFD97706" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="Time Travel" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Undo That'" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="11" Margin="0,4,0,0" FontStyle="Italic"/>
                        <TextBlock Text="Mistakes were made. Go back. GO BACK!" Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.9" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Portal Gun (App Launcher) -->
            <TextBlock Text="&#x1F680; Portal Gun" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
            <TextBlock Text="Say &quot;Open [App]&quot; or web commands to teleport instantly." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.6" FontSize="14" Margin="0,0,0,15"/>
            <WrapPanel Margin="0,0,0,30">
                <!-- The Writer -->
                <Border Width="220" Height="130" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF374151" Offset="0"/>
                            <GradientStop Color="#FF1F2937" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="The Writer" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Open Word'" Foreground="#60A5FA" FontSize="13" Margin="0,4,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="Summon the blank page. Let the words flow." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- The Navigator -->
                <Border Width="220" Height="130" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0D9488" Offset="0"/>
                            <GradientStop Color="#FF0F766E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="The Navigator" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Open Microsoft'" Foreground="#67E8F9" FontSize="13" Margin="0,4,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="Teleport directly to Microsoft.com or other sites." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- The Searcher -->
                <Border Width="220" Height="130" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF4F46E5" Offset="0"/>
                            <GradientStop Color="#FF4338CA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="The Searcher" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'Search [Query]'" Foreground="#818CF8" FontSize="13" Margin="0,4,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="Launch Google search for any topic instantly." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- The Streamer -->
                <Border Width="220" Height="130" CornerRadius="15" Margin="0,0,10,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFE11D48" Offset="0"/>
                            <GradientStop Color="#FFBE123C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="15" VerticalAlignment="Center">
                        <TextBlock Text="The Streamer" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Trigger: 'YouTube [Query]'" Foreground="#FDA4AF" FontSize="13" Margin="0,4,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="Find videos on YouTube or Utube immediately." Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
