<Window x:Class="CosmoWhisper.Views.ConfirmExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Exit CosmoWhisper" Height="300" Width="400"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="16"
            Background="{DynamicResource ThemeSurfaceBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource ThemeCardBorderHoverBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Cosmo" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeForegroundBrush}"/>
                <TextBlock Text="Whisper" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="Normal" Foreground="{DynamicResource ThemeAccentBrush}" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- Stats Block -->
            <Border Grid.Row="1" Style="{StaticResource SubtlePanelStyle}" Margin="0,18,0,14" Padding="16">
                <StackPanel>
                    <TextBlock Text="SESSION STATS" Style="{StaticResource MicroLabelStyle}" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtStats"
                               Text="124 Words Saved Today"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Fun Message -->
            <TextBlock Grid.Row="2" x:Name="TxtFunMessage"
                       Text="See you later, space cowboy!"
                       FontSize="13"
                       Foreground="{DynamicResource ThemeSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,18"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Keep Whispering"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="140"
                        Height="38"
                        Margin="0,0,12,0"
                        Click="Cancel_Click"/>

                <Button Content="Quit App"
                        Style="{StaticResource DangerButtonStyle}"
                        MinWidth="110"
                        Height="38"
                        Click="Exit_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>


