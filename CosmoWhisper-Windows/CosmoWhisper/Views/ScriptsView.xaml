<UserControl x:Class="CosmoWhisper.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Scripts Library" Foreground="White" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Manage your voice-activated automation scripts" Foreground="White" Opacity="0.6" FontSize="13" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Action Bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="+ New Script" Background="#007AFF" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="Medium" Click="NewScript_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox x:Name="SearchBox" Width="250" Height="35" Margin="15,0,0,0" Background="#15FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="10,8" VerticalContentAlignment="Center" Text="Search scripts..."/>
            </StackPanel>

            <!-- Scripts Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ScriptsPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="320" Height="160" Background="#15FFFFFF" CornerRadius="15" Margin="0,0,15,15" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Script Header -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Trigger}" Foreground="#007AFF" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Script Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="White" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>

                                    <!-- Actions -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Edit" Foreground="White" Background="Transparent" BorderThickness="0" Padding="8,4" FontSize="11"/>
                                        <Button Content="Delete" Foreground="#FF453A" Background="Transparent" BorderThickness="0" Padding="8,4" FontSize="11" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
