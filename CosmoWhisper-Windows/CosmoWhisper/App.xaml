<Application x:Class="CosmoWhisper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CosmoWhisper"
             StartupUri="WidgetWindow.xaml">
    <Application.Resources>
        <!-- DESIGN TOKENS (ITEM 1 & 3) -->
        <FontFamily x:Key="MainFont">Inter, Segoe UI, Roboto, sans-serif</FontFamily>
        <FontFamily x:Key="DisplayFont">Outfit, Inter, Segoe UI semibold</FontFamily>
        
        <!-- DYNAMIC THEME TOKENS -->
        <Color x:Key="ThemeAccentColor">#4f46e5</Color>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="{DynamicResource ThemeAccentColor}"/>
        
        <Color x:Key="ThemeGlowColor">#3b82f6</Color>
        <SolidColorBrush x:Key="ThemeGlowBrush" Color="{DynamicResource ThemeGlowColor}"/>

        <Color x:Key="ThemeSecondaryColor">#22d3ee</Color>
        <SolidColorBrush x:Key="ThemeSecondaryBrush" Color="{DynamicResource ThemeSecondaryColor}"/>

        <Color x:Key="ThemeSurfaceColor">#1e293b</Color>
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{DynamicResource ThemeSurfaceColor}" Opacity="0.6"/>

        <Color x:Key="ThemeBgStartColor">#020617</Color>
        <Color x:Key="ThemeBgMidColor">#0a0f1d</Color>
        <Color x:Key="ThemeBgEndColor">#050A14</Color>

        <LinearGradientBrush x:Key="ThemeBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource ThemeBgStartColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource ThemeBgMidColor}" Offset="0.5"/>
            <GradientStop Color="{DynamicResource ThemeBgEndColor}" Offset="1"/>
        </LinearGradientBrush>

        <Color x:Key="AccentColor">#007AFF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ThemeAccentColor}"/>
        
        <Color x:Key="GlassColor">#050505</Color>
        <SolidColorBrush x:Key="GlassBrush" Color="{DynamicResource ThemeBgStartColor}" Opacity="0.8"/>

        <!-- GLOBAL STYLES -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        </Style>

        <!-- ELASTIC BUTTON (ITEM 3) -->
        <Style x:Key="ElasticButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="#20FFFFFF">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="50" CenterY="25"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="2"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="2"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
